{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aiplaygrounds-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-05",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "force-trailing-slash",
    "not_found_handling": "none"
  }
}
