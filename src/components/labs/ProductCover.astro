---
import type { Product } from '../../data/labs';

interface Props {
  product: Product;
  detail?: boolean;
  eager?: boolean;
}
const { product, detail = false, eager = false } = Astro.props;
const { cover } = product;
const artwork =
  product.demo &&
  {
    'demo-codeassist': 'code',
    'demo-semantic-search': 'search',
    'demo-flow-studio': 'workflow',
  }[product.id];
---

<div
  class:list={['product-cover', { detail }]}
  data-artwork={artwork || 'abstract'}
>
  <div class="cover-art">
    {cover ? (
      <img
        src={cover.src}
        alt={detail ? cover.alt : ''}
        width={cover.width}
        height={cover.height}
        loading={detail || eager ? 'eager' : 'lazy'}
        fetchpriority={detail ? 'high' : undefined}
        decoding="async"
      />
    ) : (
      <svg
        viewBox="0 0 960 320"
        preserveAspectRatio={detail ? 'xMidYMid slice' : 'xMidYMid meet'}
        aria-hidden="true"
      >
        <path
          class="wave"
          d="M0 251Q118 170 248 227T493 211 722 127 960 148V320H0Z"
        />
        <path
          class="wave deep"
          d="M0 301Q130 195 272 255T524 264 765 232 960 206V320H0Z"
        />
        {artwork === 'code' ? (
          <g transform="translate(245 48) rotate(-6 230 112)">
            <rect width="470" height="242" rx="17" fill="#19352d" />
            <path d="M0 45H470M102 45V242" stroke="#567367" stroke-width="3" />
            <path
              d="M26 22h1m20 0h1m20 0h1"
              stroke="#b4d9bd"
              stroke-width="9"
              stroke-linecap="round"
            />
            <path
              d="M29 77h51m-51 25h38m-38 25h49m-49 25h29"
              stroke="#7e9b91"
              stroke-width="7"
              stroke-linecap="round"
            />
            <path
              d="M132 76h129m-129 61h92m-92 62h155"
              stroke="#b1a5ea"
              stroke-width="12"
              stroke-linecap="round"
            />
            <path
              d="M157 106h174m-174 62h111"
              stroke="#66d49c"
              stroke-width="12"
              stroke-linecap="round"
            />
            <rect
              x="338"
              y="121"
              width="209"
              height="105"
              rx="22"
              fill="#3e946d"
              stroke="#f1fff3"
              stroke-width="4"
            />
            <path
              d="M374 143q4 14 18 18-14 4-18 18-4-14-18-18 14-4 18-18Z"
              fill="#f1fff3"
            />
            <path
              d="M359 193h151m-151 15h103"
              stroke="#f1fff3"
              stroke-width="6"
              stroke-linecap="round"
            />
          </g>
        ) : artwork === 'search' ? (
          <g fill="#f5f8fc" stroke="#80a5be" stroke-width="3">
            <rect
              x="262"
              y="91"
              width="133"
              height="176"
              rx="11"
              transform="rotate(-8 329 179)"
            />
            <rect x="420" y="48" width="128" height="180" rx="11" />
            <rect
              x="568"
              y="91"
              width="123"
              height="176"
              rx="11"
              transform="rotate(8 630 179)"
            />
            <path
              d="M285 123l61-8m-57 32l76-11m80-61h50m-50 24h75m72 19l52 7m-55 17l72 10M307 222l49-7m245 1l38 6"
              stroke-width="8"
              stroke-linecap="round"
            />
            <rect
              x="325"
              y="139"
              width="311"
              height="66"
              rx="16"
              stroke="#3f687f"
              stroke-width="4"
            />
            <circle
              cx="365"
              cy="168"
              r="13"
              fill="none"
              stroke="#3f687f"
              stroke-width="4"
            />
            <path
              d="m375 178 11 11m24-17h193"
              stroke="#3f687f"
              stroke-width="6"
              stroke-linecap="round"
            />
          </g>
        ) : artwork === 'workflow' ? (
          <g stroke="#64764c" stroke-width="5" fill="none">
            <path d="M356 117h40q16 0 16 16v33q0 16 16 16h29m89 0h36q16 0 16-16v-17q0-16 16-16h37" />
            <rect
              x="230"
              y="76"
              width="130"
              height="78"
              rx="15"
              fill="#fcfaf0"
            />
            <rect
              x="445"
              y="143"
              width="115"
              height="80"
              rx="15"
              fill="#7c945c"
              stroke="#fcfaf0"
            />
            <rect
              x="644"
              y="95"
              width="130"
              height="78"
              rx="15"
              fill="#fcfaf0"
            />
            <path
              d="M256 105h48m-48 22h72m340-4h48m-48 22h72"
              stroke-linecap="round"
            />
            <path d="m491 166 28 17-28 17Z" fill="#fcfaf0" stroke="none" />
          </g>
        ) : (
          <g stroke="currentColor" stroke-width="3" fill="none" opacity=".7">
            <path d="m480 55 177 65-177 65-177-65Zm-177 105 177 65 177-65m-354 40 177 65 177-65" />
            <path
              d="M196 103h64m440 116h64M216 128h20m488 66h20"
              stroke-linecap="round"
            />
          </g>
        )}
      </svg>
    )}
  </div>
  <slot />
</div>

<style>
  .product-cover {
    position: relative;
    inline-size: 100%;
    aspect-ratio: 16 / 9;
    overflow: clip;
    color: var(--editorial-grove-ink);
    background: var(--editorial-grove);
  }
  .product-cover:has(:global(.vertical:nth-child(4))) {
    min-block-size: 7.5rem;
  }
  .product-cover.detail {
    aspect-ratio: 3;
    max-block-size: 22rem;
    min-block-size: 8rem;
    border-radius: var(--editorial-radius);
  }
  .cover-art,
  img,
  svg {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }
  img {
    object-fit: cover;
  }
  .wave {
    fill: currentColor;
    opacity: 0.14;
  }
  .deep {
    opacity: 0.2;
  }
  [data-artwork='search'] {
    background: #dce8f0;
    color: #4b7a9d;
  }
  [data-artwork='workflow'] {
    background: var(--editorial-sand);
  }
  @media (prefers-reduced-motion: no-preference) {
    .cover-art {
      transform: scale(calc(1 + var(--surface-motion, 0) * 0.035));
      transition: transform 380ms var(--editorial-ease-out);
    }
  }
</style>
