---
import {
  BuildingComplex,
  Building,
  UserRound,
  UsersRound,
} from '@lucide/astro';
import type { Product } from '../../data/labs';
import VerticalTag from '../directory/VerticalTag.astro';
import Badge from '../ui/Badge.astro';
import { compactHeroArt } from '../site/compact-hero-art';

interface Props {
  product: Product;
  kind: 'cover' | 'scopes';
  overlay?: boolean;
}

const { product, kind, overlay } = Astro.props;
const scopeIcons = {
  Individual: UserRound,
  Team: UsersRound,
  Organization: Building,
  Enterprise: BuildingComplex,
};
const scopeColors = {
  Individual: compactHeroArt.convergence.palette[2],
  Team: compactHeroArt.construction.palette[2],
  Organization: compactHeroArt.exploration.palette[2],
  Enterprise: compactHeroArt.connection.palette[2],
};
---

{kind === 'cover' ? (
  <div class:list={['product-tags', { overlay }]}>
    {product.verticals.length > 0 && (
      <div class="verticals">
        {product.verticals.map((vertical) => (
          <VerticalTag {vertical} />
        ))}
      </div>
    )}
    <Badge
      class="maturity"
      variant="success"
      size="editorial"
      appearance="outline"
      indicator
      data-maturity={product.maturity}
      lang="en"
    >
      {product.maturity}
    </Badge>
  </div>
) : (
  <ul class="product-tags" aria-label="Alcance de uso" role="list">
    {product.scopes.map((scope) => {
      const Icon = scopeIcons[scope];
      return (
        <Badge
          as="li"
          variant="surface"
          size="editorial"
          class="scope"
          lang="en"
          style={{ '--badge-surface': scopeColors[scope] }}
        >
          <Icon slot="icon" size={14} aria-hidden="true" />
          {scope}
        </Badge>
      );
    })}
  </ul>
)}

<style>
  .product-tags,
  .verticals {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: var(--space-inline);
  }
  .verticals {
    min-inline-size: 0;
    flex: 1 1 7rem;
  }
  .overlay {
    position: absolute;
    inset: 0.65rem 0.65rem auto;
    pointer-events: none;
  }
  .overlay .maturity {
    margin-inline-start: auto;
  }
  .maturity {
    --badge-outline-surface: var(--home-card);
    --badge-ink: var(--success);
    --badge-line: var(--line);
    white-space: nowrap;
  }
  .maturity[data-maturity='Prototype'] {
    --badge-ink: var(--editorial-lilac-ink);
  }
  .maturity[data-maturity='Alpha'] {
    --badge-ink: var(--editorial-sand-ink);
  }
  .scope {
    --badge-ink: var(--web-light-text);
  }
  @media (min-width: 45rem) {
    :global([data-view='list']) .overlay :global(.vertical),
    :global([data-view='list']) .overlay .maturity {
      padding-inline: 0.42rem;
      font-size: var(--type-caption);
    }
  }
</style>
