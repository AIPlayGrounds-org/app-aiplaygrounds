---
import {
  BuildingComplex,
  Building,
  UserRound,
  UsersRound,
} from '@lucide/astro';
import type { Product } from '../../data/labs';
import VerticalTag from '../directory/VerticalTag.astro';
import { compactHeroArt } from '../site/compact-hero-art';

interface Props {
  product: Product;
  kind: 'cover' | 'scopes';
  overlay?: boolean;
}

const { product, kind, overlay } = Astro.props;
const scopeIcons = {
  Individual: UserRound,
  Team: UsersRound,
  Organization: Building,
  Enterprise: BuildingComplex,
};
const scopeColors = {
  Individual: compactHeroArt.convergence.palette[2],
  Team: compactHeroArt.construction.palette[2],
  Organization: compactHeroArt.exploration.palette[2],
  Enterprise: compactHeroArt.connection.palette[2],
};
---

{kind === 'cover' ? (
  <div class:list={['product-tags', { overlay }]}>
    {product.verticals.length > 0 && (
      <div class="verticals">
        {product.verticals.map((vertical) => (
          <VerticalTag {vertical} />
        ))}
      </div>
    )}
    <span class="maturity" data-maturity={product.maturity} lang="en">
      {product.maturity}
    </span>
  </div>
) : (
  <ul class="product-tags" aria-label="Alcance de uso" role="list">
    {product.scopes.map((scope) => {
      const Icon = scopeIcons[scope];
      return (
        <li
          class="scope"
          lang="en"
          style={{ '--scope-background': scopeColors[scope] }}
        >
          <Icon size={14} aria-hidden="true" />
          {scope}
        </li>
      );
    })}
  </ul>
)}

<style>
  .product-tags,
  .verticals {
    display: flex;
    flex-wrap: wrap;
    align-items: start;
    gap: 0.35rem;
  }
  .verticals {
    min-inline-size: 0;
    flex: 1 1 7rem;
  }
  .overlay {
    position: absolute;
    inset: 0.65rem 0.65rem auto;
    pointer-events: none;
  }
  .overlay .maturity {
    margin-inline-start: auto;
  }
  .product-tags :is(.maturity, .scope) {
    display: inline-flex;
    max-inline-size: 100%;
    align-items: center;
    gap: 0.35rem;
    border-radius: 0.25rem;
    padding: 0.2rem 0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1.25;
  }
  svg {
    flex: none;
  }
  .maturity {
    background: var(--home-card);
    color: var(--success);
    border: 1px solid var(--border);
    white-space: nowrap;
  }
  .maturity::before {
    content: '';
    inline-size: 0.46rem;
    block-size: 0.46rem;
    border-radius: 50%;
    background: currentColor;
  }
  .maturity[data-maturity='Prototype'] {
    color: var(--editorial-lilac-ink);
  }
  .maturity[data-maturity='Alpha'] {
    color: var(--editorial-sand-ink);
  }
  .scope {
    padding-block: 0.3rem;
    background: var(--scope-background);
    color: var(--web-light-text);
  }
  @media (min-width: 45rem) {
    :global([data-view='list']) .overlay :global(.vertical),
    :global([data-view='list']) .overlay .maturity {
      padding-inline: 0.42rem;
      font-size: 0.75rem;
    }
  }
</style>
