---
import Card from '../ui/Card.astro';
import { ArrowUpRight } from '@lucide/astro';
import { productAuthors, productPath, type Product } from '../../data/labs';
import ProductCover from './ProductCover.astro';
import ProductTags from './ProductTags.astro';

interface Props {
  product: Product;
  eager?: boolean;
}
const { product, eager } = Astro.props;
---

<Card
  as="article"
  surface="inherit"
  density="none"
  edge="none"
  interaction="single-link"
  class="labs-card"
>
  <div class="card-cover">
    <ProductCover {product} {eager}>
      <ProductTags {product} kind="cover" overlay />
    </ProductCover>
  </div>
  <div class="card-body">
    <p class="card-category">{product.category}</p>
    <h3 class="directory-card-title">{product.name}</h3>
    <ProductTags {product} kind="scopes" />
    <p class="card-summary">{product.summary}</p>
    <footer>
      <p>
        Por {productAuthors(product)}
        {product.demo && <small class="card-demo">Demostración</small>}
      </p>
      <a
        href={productPath(product.slug)}
        aria-label={`Ver ficha: ${product.name}`}
        data-card-link
      >
        Ver ficha{' '}
        <ArrowUpRight class="size-icon-md" aria-hidden="true" data-card-arrow />
      </a>
    </footer>
  </div>
</Card>

<style>
  .labs-card {
    display: flex;
    flex-direction: column;
    block-size: 100%;
    border: var(--stroke-default) solid var(--card-edge);
    border-radius: var(--editorial-radius);
    background: var(--home-card);
    overflow-wrap: anywhere;
  }
  .card-cover {
    overflow: clip;
    border-radius: calc(var(--editorial-radius) - 1px)
      calc(var(--editorial-radius) - 1px) 0 0;
  }
  .card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: start;
    min-inline-size: 0;
    gap: var(--space-related);
    padding: var(--space-card) var(--space-card) var(--space-stack);
  }
  .card-body > :global(.product-tags) {
    margin-block: var(--space-inline);
  }
  .card-category,
  .card-demo,
  .card-summary,
  footer p {
    color: var(--secondary-text);
  }
  .card-category,
  .card-demo {
    font-size: var(--type-label);
  }
  .card-demo {
    display: block;
  }
  .card-summary {
    display: -webkit-box;
    overflow: clip;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    font-size: var(--type-body-small);
    line-height: var(--leading-body);
    margin-block: var(--space-inline) var(--space-control);
  }
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-related);
    inline-size: 100%;
    margin-block-start: auto;
    font-size: var(--type-label);
    align-items: end;
  }
  footer p {
    min-inline-size: 0;
    flex: 1 1 8rem;
  }
  footer a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-inline);
    min-block-size: 44px;
    font-weight: var(--weight-medium);
    color: var(--foreground);
    white-space: nowrap;
  }
  @media (min-width: 45rem) {
    :global([data-view='list']) .labs-card {
      display: grid;
      grid-template-columns: minmax(14rem, 2fr) minmax(0, 3fr);
    }
    :global([data-view='list']) .card-cover {
      align-self: start;
      border-radius: calc(var(--editorial-radius) - 1px) 0 0 0;
    }
    :global(.related-products) .card-cover {
      position: relative;
      align-self: stretch;
      border-end-start-radius: calc(var(--editorial-radius) - 1px);
    }
    :global(.related-products) .card-cover > :global(.product-cover) {
      position: absolute;
      inset: 0;
      block-size: 100%;
      aspect-ratio: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .labs-card {
      transition: none;
    }
  }
</style>
