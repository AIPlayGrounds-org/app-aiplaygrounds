---
import Card from '../ui/Card.astro';
import { Image } from 'astro:assets';
import { Globe, UserRound } from '@lucide/astro';
import type { TeamMember } from '../../data/team';

interface Props {
  member: TeamMember;
  role: string;
  layout: 'vertical' | 'horizontal';
  heading: 'h3' | 'h4';
}

const { member, role, layout, heading: Heading } = Astro.props;
const { id, name, photo } = member;
const preview = import.meta.env.DEV;
const professionalRole =
  member.professionalRole ?? (preview ? 'Perfil profesional' : undefined);
const links = [
  { key: 'linkedin', label: 'LinkedIn', href: member.linkedin },
  { key: 'github', label: 'GitHub', href: member.github },
  { key: 'website', label: 'Sitio web', href: member.website },
].filter(({ href }) => href);
---

<Card
  as="article"
  surface="inherit"
  density="none"
  edge="none"
  interaction="interactive"
  class:list={['team-card', layout]}
  data-member={id}
  data-reveal="card"
>
  {(photo || preview) && (
    <div class="portrait">
      {photo ? (
        <Image
          src={photo}
          alt=""
          width={layout === 'vertical' ? 768 : 384}
          height={layout === 'vertical' ? 768 : 384}
          fit="cover"
          loading="lazy"
        />
      ) : (
        <div class="portrait-placeholder" aria-hidden="true">
          <UserRound size="45%" stroke-width={1} />
        </div>
      )}
    </div>
  )}
  <div class="details">
    <div class="identity">
      <Heading>{name}</Heading>
      <p class="organization-role">{role}</p>
      {professionalRole && <p class="professional-role">{professionalRole}</p>}
    </div>
    {links.length > 0 && (
      <div class="links">
        {links.map(({ key, label, href }) => (
          <a
            {href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${label}: ${name} (abre en una pestaña nueva)`}
          >
            {key === 'website' ? (
              <Globe size={16} aria-hidden="true" />
            ) : (
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                {key === 'linkedin' ? (
                  <>
                    <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
                    <rect width="4" height="12" x="2" y="9" />
                    <circle cx="4" cy="4" r="2" />
                  </>
                ) : (
                  <>
                    <path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 6v-3.9a3.4 3.4 0 0 0-.9-2.6c3-.3 6.2-1.5 6.2-6.8a5.3 5.3 0 0 0-1.4-3.7 4.9 4.9 0 0 0-.1-3.7S17.7 1 15 2.7a14 14 0 0 0-6 0C6.3 1 5.2 1.3 5.2 1.3A4.9 4.9 0 0 0 5.1 5a5.3 5.3 0 0 0-1.4 3.7c0 5.3 3.2 6.5 6.2 6.8a3.4 3.4 0 0 0-.9 2.6V22" />
                  </>
                )}
              </svg>
            )}
          </a>
        ))}
      </div>
    )}
  </div>
</Card>

<style>
  .team-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    background: var(--home-card);
    border: var(--stroke-default) solid var(--card-edge);
    border-radius: var(--editorial-radius);
    container-type: inline-size;
  }
  .horizontal {
    --portrait-size: 9rem;
  }
  @media (min-width: 22.5rem) {
    .horizontal:has(.portrait) {
      grid-template-columns: var(--portrait-size) minmax(0, 1fr);
    }
    .horizontal .portrait {
      align-self: stretch;
    }
  }
  .portrait {
    position: relative;
    inline-size: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--surface-contrast);
  }
  .portrait > :is(img, .portrait-placeholder) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .portrait-placeholder {
    display: grid;
    place-items: center;
    color: var(--muted-foreground);
  }
  .vertical .portrait-placeholder {
    background: var(--editorial-lilac);
  }
  .vertical:first-child .portrait-placeholder {
    background: var(--editorial-sand);
  }
  .vertical:last-child .portrait-placeholder {
    background: var(--editorial-grove);
  }
  .details {
    display: grid;
    align-content: start;
    gap: var(--space-related);
    padding: 0.875rem clamp(0.75rem, 4cqi, 1.375rem);
    line-height: var(--leading-compact);
    overflow-wrap: anywhere;
  }
  .horizontal .details {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: var(--space-inline);
    padding-inline: clamp(1rem, 6cqi, 1.5rem) 0.625rem;
    line-height: var(--leading-title);
  }
  .details :is(h3, h4) {
    margin: 0;
    font: 600 clamp(1.0625rem, 1rem + 0.5cqi, 1.375rem) / 1.15
      var(--font-heading);
    letter-spacing: var(--tracking-heading);
    text-wrap: pretty;
    color: var(--brand-black);
  }
  .vertical .details h3 {
    font-size: clamp(1.25rem, 1rem + 1.8cqi, 1.625rem);
  }
  .details .organization-role {
    margin: 0.375rem 0 0;
    color: var(--interaction-accent);
    font-size: var(--type-body-small);
    font-weight: var(--weight-medium);
  }
  .details .professional-role {
    margin: 0.25rem 0 0;
    color: var(--secondary-text);
    font-size: var(--type-label);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .links a {
    display: grid;
    place-items: start;
    inline-size: 1.75rem;
    block-size: 1.75rem;
    padding-block-start: 0.375rem;
    border-radius: var(--radius-sm);
    color: var(--secondary-text);
    transition:
      color var(--editorial-response) var(--editorial-ease-out),
      background-color var(--editorial-response) var(--editorial-ease-out);
  }
  .links a:is(:hover, :focus-visible) {
    color: var(--interaction-accent);
    background: var(--editorial-lilac);
  }
  .links a:focus-visible {
    outline-offset: 1px;
  }
  .horizontal .links a {
    block-size: 1.5rem;
  }
  .links svg {
    inline-size: 16px;
    block-size: 16px;
    /* Optical alignment: strokes start 1–2 units inside the 24-unit viewBox. */
    margin-inline-start: -1px;
  }
  @media (pointer: coarse) {
    .horizontal {
      --portrait-size: 9.75rem;
    }
    .links a {
      block-size: 2.25rem;
    }
    .horizontal .links a {
      block-size: 2rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .portrait > :is(img, .portrait-placeholder) {
      scale: calc(1 + var(--surface-motion, 0) * var(--motion-media-zoom));
      transition: scale var(--duration-disclosure) var(--editorial-ease-out);
    }
    .links svg {
      transition: translate var(--editorial-response) var(--editorial-ease-out);
    }
    .links a:is(:hover, :focus-visible) svg {
      translate: 0 -2px;
    }
  }
</style>
