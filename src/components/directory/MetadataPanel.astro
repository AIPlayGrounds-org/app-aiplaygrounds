---
import type { Info } from '@lucide/astro';
import Card from '../ui/Card.astro';

interface Props {
  title: string;
  icon: typeof Info;
  fields?: [label: string, value?: string, lang?: string][];
}
const { title, icon: Icon, fields = [] } = Astro.props;
const visible = fields.filter(([, value]) => value);
---

<Card
  as="section"
  class="detail-panel block"
  surface="inherit"
  density="none"
  edge="none"
>
  <h2>
    <Icon size={21} aria-hidden="true" /> {title}
  </h2>
  <slot name="before" />
  {visible.length > 0 && (
    <dl>
      {visible.map(([label, value, lang]) => (
        <div>
          <dt>{label}</dt>
          <dd {lang}>{value}</dd>
        </div>
      ))}
    </dl>
  )}
  <slot />
</Card>
