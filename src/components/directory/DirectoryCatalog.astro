---
import { ChevronDown, ChevronRight, SlidersHorizontal, X } from '@lucide/astro';
import Button from '../ui/Button.astro';
import Dialog from '../ui/Dialog.astro';
import Select from '../ui/Select.astro';
import Label from '../ui/Label.astro';
import Pagination from '../ui/Pagination.astro';
import SearchField from '../composed/SearchField.astro';
import ViewToggle from '../composed/ViewToggle.astro';
import FilterGroup from '../composed/FilterGroup.astro';
import DirectoryFilter from './DirectoryFilter.astro';
import {
  directoryLimits,
  sortOptions,
  type DirectoryFacet,
  type DirectoryView,
} from '../../data/directory';
import '../../styles/directory.css';

interface Props {
  directory: string;
  sectionId: string;
  title: string;
  singular: string;
  plural: string;
  emptyMessage: string;
  placeholder: string;
  total: number;
  primary: DirectoryFacet[];
  secondary: DirectoryFacet[];
  defaultView: DirectoryView;
  labels?: typeof sortOptions;
}
const {
  directory,
  sectionId,
  title,
  singular,
  plural,
  emptyMessage,
  placeholder,
  total,
  primary,
  secondary,
  defaultView,
  labels = sortOptions,
} = Astro.props;
const hasFilters = primary.length + secondary.length > 0;
---

<section
  id={sectionId}
  class="site-container labs-directory"
  aria-labelledby={`${directory}-title`}
>
  <h2 id={`${directory}-title`}>{title}</h2>
  {total === 0 ? (
    <p class="labs-empty">{emptyMessage}</p>
  ) : (
    <div
      class="catalog"
      data-directory={directory}
      data-section={sectionId}
      data-singular={singular}
      data-plural={plural}
    >
      <div class="catalog-toolbar">
        <search class="catalog-search" aria-label={title} data-enhanced>
          <SearchField
            as="form"
            searchableForm
            appearance="inline"
            id={`${directory}-query`}
            label={`Buscar ${plural}`}
            data-query
            name="q"
            {placeholder}
          >
            <Button
              variant="plain"
              iconOnly
              type="button"
              class="search-clear"
              data-clear-query
              aria-label="Limpiar búsqueda"
              hidden
            >
              <X size={17} aria-hidden="true" />
            </Button>
          </SearchField>
        </search>
        {hasFilters && (
          <>
            <Button
              variant="plain"
              type="button"
              class="mobile-filter control"
              aria-haspopup="dialog"
              aria-controls={`${directory}-filter-dialog`}
              data-enhanced
            >
              <SlidersHorizontal size={18} aria-hidden="true" />
              Filtros
            </Button>
            <div class="filter-home" data-filter-home>
              <div class="filter-content" data-filter-content>
                <FilterGroup
                  id={`${directory}-filters`}
                  class="catalog-filters"
                  aria-label={`Filtros de ${plural}`}
                  data-enhanced
                >
                  {primary.map((group) => (
                    <DirectoryFilter {group} {directory} {plural} dropdown />
                  ))}
                  {secondary.length > 0 && (
                    <Button
                      variant="plain"
                      type="button"
                      class="control more-toggle"
                      aria-expanded="false"
                      aria-controls={`${directory}-advanced`}
                      data-more-toggle
                    >
                      <SlidersHorizontal size={17} aria-hidden="true" />
                      Más filtros <span data-advanced-count hidden></span>
                      <ChevronRight
                        size={16}
                        aria-hidden="true"
                        class="more-chevron"
                      />
                    </Button>
                  )}
                </FilterGroup>
                {secondary.length > 0 && (
                  <div class="advanced-region" data-advanced-region>
                    <div class="advanced-inner">
                      <div
                        class="advanced-panel"
                        id={`${directory}-advanced`}
                        data-advanced-panel
                        inert
                      >
                        <div class="advanced-grid">
                          {secondary.map((group) => (
                            <DirectoryFilter
                              {group}
                              {directory}
                              {plural}
                              advanced
                            />
                          ))}
                        </div>
                        <div class="advanced-actions">
                          <Button
                            variant="plain"
                            type="button"
                            class="reset-button"
                            data-panel-clear
                          >
                            Limpiar filtros
                          </Button>
                          <Button
                            variant="primary"
                            type="button"
                            class="apply-button"
                            data-panel-apply
                          >
                            Aplicar filtros
                          </Button>
                        </div>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </div>
            <Dialog
              layout="custom"
              class="filter-dialog"
              id={`${directory}-filter-dialog`}
              data-filter-dialog
              aria-labelledby={`${directory}-filter-title`}
            >
              <header class="filter-dialog-header">
                <h2 id={`${directory}-filter-title`}>Filtros</h2>
                <form method="dialog">
                  <Button
                    variant="plain"
                    iconOnly
                    type="submit"
                    aria-label="Cerrar filtros"
                    autofocus
                  >
                    <X size={20} aria-hidden="true" />
                  </Button>
                </form>
              </header>
              <div data-drawer-content></div>
              <div data-drawer-actions>
                {secondary.length === 0 && (
                  <div class="advanced-actions">
                    <Button
                      variant="plain"
                      type="button"
                      class="reset-button"
                      data-panel-clear
                    >
                      Limpiar filtros
                    </Button>
                    <Button
                      variant="primary"
                      type="button"
                      class="apply-button"
                      data-panel-apply
                    >
                      Aplicar filtros
                    </Button>
                  </div>
                )}
              </div>
            </Dialog>
          </>
        )}
      </div>
      <div class="catalog-results">
        <div class="result-toolbar">
          <p data-count role="status" tabindex="-1">
            {total} {total === 1 ? singular : plural}
          </p>
          <div class="view-options" data-enhanced>
            <Label for={`${directory}-sort`} class="sr-only">
              Ordenar {plural}
            </Label>
            <div class="sort-field">
              <Select
                appearance="inline"
                id={`${directory}-sort`}
                name="sort"
                class="control dropdown-trigger"
                data-sort
              >
                {Object.entries(labels).map(([value, label]) => (
                  <option {value}>{label}</option>
                ))}
              </Select>
              <ChevronDown size={16} aria-hidden="true" />
            </div>
            <ViewToggle
              class="view-toggle"
              value={defaultView}
              controlClass="control"
            />
          </div>
        </div>
        <div class="active-filters" data-active-filters hidden>
          <ul aria-label="Filtros activos" role="list" data-tags></ul>
          <Button
            variant="plain"
            type="button"
            class="reset-button"
            data-clear-filters
          >
            Limpiar filtros
          </Button>
        </div>
        <ul
          class="catalog-cards"
          data-cards
          data-view={defaultView}
          role="list"
        >
          <slot />
        </ul>
        <div class="labs-empty" data-no-results hidden>
          <h3>No encontramos {plural}</h3>
          <p>Prueba con otra búsqueda o quita algunos filtros.</p>
          <Button variant="plain" type="button" class="reset-button" data-reset>
            Limpiar búsqueda y filtros
          </Button>
        </div>
        {total > directoryLimits.pageSize && (
          <Pagination
            class="catalog-pages"
            managed
            hidden
            controlClass="control"
          />
        )}
      </div>
    </div>
  )}
</section>

<script>
  import '../../scripts/directory';
</script>
