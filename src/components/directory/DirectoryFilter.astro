---
import { ChevronDown } from '@lucide/astro';
import type { DirectoryFacet } from '../../data/directory';

interface Props {
  group: DirectoryFacet;
  directory: string;
  plural: string;
  dropdown?: boolean;
  advanced?: boolean;
}
const { group, directory, plural, dropdown, advanced = false } = Astro.props;
---

<div
  class:list={['facet-wrap', { 'advanced-facet': advanced }]}
  data-facet-wrap
>
  {advanced && (
    <span class="facet-label" id={`${directory}-label-${group.key}`}>
      {group.label}
    </span>
  )}
  <details
    class="facet"
    name={`${directory}-facets`}
    data-dropdown={dropdown || advanced || undefined}
  >
    <summary
      class:list={[{ 'control dropdown-trigger': dropdown || advanced }]}
      aria-labelledby={
        advanced
          ? `${directory}-label-${group.key} ${directory}-value-${group.key}`
          : undefined
      }
    >
      {advanced ? (
        <span id={`${directory}-value-${group.key}`} data-facet-summary>
          Todas
        </span>
      ) : (
        group.label
      )}
      <ChevronDown size={16} aria-hidden="true" />
    </summary>
    <fieldset class="facet-options">
      <legend class="sr-only">{group.label}</legend>
      {group.options.map(([value, label]) => (
        <label>
          <input
            type="checkbox"
            name={group.key}
            {value}
            data-facet
            data-advanced={advanced || undefined}
          />
          <span data-option-label>{label}</span>
          <span class="option-count" data-option-count>
            <span aria-hidden="true">0</span>
            <span class="sr-only">0 {plural}</span>
          </span>
        </label>
      ))}
    </fieldset>
  </details>
</div>
