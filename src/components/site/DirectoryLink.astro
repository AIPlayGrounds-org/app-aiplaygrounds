---
import { ArrowLeft, ArrowRight } from '@lucide/astro';

interface Props {
  href: string;
  title: string;
  back?: boolean;
}
const { href, title, back = false } = Astro.props;
---

<a
  class:list={['directory-link', { 'directory-back': back }]}
  href={href}
  data-card-link={!back || undefined}
  aria-label={back ? undefined : `Ver ficha: ${title}`}
>
  {back ? (
    <>
      <ArrowLeft class="size-icon-md" aria-hidden="true" /> Volver a {title}
    </>
  ) : (
    <>
      Ver ficha
      <ArrowRight class="size-icon-md" aria-hidden="true" data-card-arrow />
    </>
  )}
</a>

<style>
  .directory-link {
    --arrow-y: 0px;
    display: inline-flex;
    align-items: center;
    gap: var(--space-control);
    min-block-size: 44px;
    font-weight: var(--weight-medium);
  }
  .directory-link :global(svg) {
    flex: none;
  }
  .directory-back {
    margin-block-end: var(--space-card);
  }
</style>
