---
import { Image } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import { inicioImages } from '../../assets/inicio';
import Button from '../starwind/button/Button.astro';
interface Props {
  id: string;
  title: string;
  paragraphs: string[];
  buttons: { label: string; href: string; variant: 'primary' | 'outline' }[];
}
const { id, title, paragraphs, buttons } = Astro.props;
const home = id === 'I8' && Astro.url.pathname === '/';
---

<section {id} class="site-container section-space closing-section">
  <div class="closing">
    <div class="closing-copy">
      <h2>{title}</h2>
      {paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <div class="actions">
        {buttons.map((button) => (
          <Button href={button.href} variant={button.variant}>
            {button.label}
            {home && <ArrowUpRight aria-hidden="true" size={14} />}
          </Button>
        ))}
      </div>
    </div>
    <Image
      src={inicioImages.closing}
      alt=""
      format="webp"
      widths={[480, 768, 1024, 1440, 1920, 2172]}
      sizes="(min-width: 80rem) 1280px, 100vw"
      loading="lazy"
      class="closing-image"
    />
  </div>
</section>
<style>
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .actions :global(a) {
    max-width: 100%;
    height: auto;
    min-height: 2.75rem;
    white-space: normal;
    text-align: center;
    padding-block: 0.625rem;
  }
  .closing h2 {
    font-size: clamp(2rem, 1.5rem + 1.5vw, 3rem);
  }
  .closing-section {
    padding-top: 1rem;
  }
  .closing {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    min-height: 20rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    align-items: center;
    background: var(--home-surface);
  }
  .closing-copy {
    padding: clamp(2rem, 4vw, 3.5rem);
  }
  .closing h2 {
    max-width: 20ch;
  }
  .closing p {
    color: var(--secondary-text);
    margin-top: 1rem;
  }
  .closing .actions {
    margin-top: 1rem;
  }
  .closing-image {
    align-self: stretch;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    object-position: right bottom;
  }
  :global(body.home) .closing-section {
    padding-bottom: clamp(2rem, 4vw, 3.25rem);
  }
  :global(body.home) .actions :global(a) {
    border-radius: 0.5rem;
  }
  @media (min-width: 60rem) {
    :global(body.home) .closing {
      grid-template-columns: minmax(0, 55%) 1fr;
      min-height: clamp(21rem, 28vw, 24.5rem);
    }
    :global(body.home) .closing-copy {
      position: relative;
      z-index: 1;
      padding-inline-end: clamp(1.5rem, 3vw, 2.5rem);
    }
    :global(body.home) .closing-image {
      position: absolute;
      inset: auto 0 0 auto;
      width: 91%;
      height: auto;
      pointer-events: none;
    }
  }
  @media (min-width: 60rem) {
    .closing-section {
      padding-top: 0.75rem;
    }
  }
  @media (max-width: 48rem) {
    .closing {
      display: block;
    }
    .closing-copy {
      padding: clamp(1.5rem, 5vw, 2rem);
    }
    .closing .actions {
      flex-direction: column;
      align-items: stretch;
    }
    .closing .actions :global(a) {
      width: 100%;
    }
    .closing-image {
      display: block;
      height: auto;
      aspect-ratio: 2.8 / 1;
    }
  }
</style>
