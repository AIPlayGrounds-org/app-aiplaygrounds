---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ArrowUpRight } from '@lucide/astro';
import { inicioImages } from '../../assets/inicio';
import Button from '../ui/Button.astro';
interface Props {
  id: string;
  title: string;
  paragraphs: string[];
  buttons: { label: string; href: string; variant: 'primary' | 'outline' }[];
  illustration?: ImageMetadata;
  density?: 'compact';
}
const { id, title, paragraphs, buttons, illustration, density } = Astro.props;
const home = id === 'I8' && Astro.url.pathname === '/';
---

<section
  {id}
  class="site-container section-space closing-section"
  data-density={density}
>
  <div
    class:list={['closing', { 'closing-cutout': illustration }]}
    data-reveal={home || illustration ? 'card' : undefined}
    data-surface-motion={home || Boolean(illustration) || undefined}
    data-card-outline
  >
    <div class="closing-copy">
      <h2>{title}</h2>
      {paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <div class="actions">
        {buttons.map((button) => (
          <Button
            href={button.href}
            variant={button.variant}
            data-surface-motion={home || Boolean(illustration) || undefined}
          >
            {button.label}
            {(home || illustration) && (
              <ArrowUpRight aria-hidden="true" size={14} data-card-arrow />
            )}
          </Button>
        ))}
      </div>
    </div>
    <Image
      src={illustration ?? inicioImages.closing}
      alt=""
      format="webp"
      widths={
        illustration
          ? [480, 768, 1024, 1440]
          : [480, 768, 1024, 1440, 1920, 2172]
      }
      sizes={
        illustration
          ? '(max-width: 48rem) 88vw, (min-width: 86rem) 700px, 56vw'
          : '(min-width: 80rem) 1280px, 100vw'
      }
      loading="lazy"
      class="closing-image"
    />
  </div>
</section>
<style>
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-control);
  }
  .actions :global(a) {
    max-width: 100%;
    height: auto;
    min-height: 2.75rem;
    white-space: normal;
    text-align: center;
    padding-block: 0.625rem;
  }
  .closing h2 {
    font-size: var(--type-section);
  }
  .closing-section {
    padding-top: 1rem;
  }
  .closing {
    position: relative;
    overflow: hidden;
    border: var(--stroke-default) solid var(--line);
    border-radius: var(--radius-large);
    min-height: 20rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    align-items: center;
    background: var(--home-surface);
  }
  .closing-copy {
    padding: clamp(2rem, 4vw, 3.5rem);
  }
  .closing h2 {
    max-width: 20ch;
  }
  .closing p {
    color: var(--secondary-text);
    margin-top: var(--space-stack);
  }
  .closing .actions {
    margin-top: var(--space-stack);
  }
  .closing-image {
    align-self: stretch;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: cover;
    object-position: right bottom;
  }
  .closing-cutout .closing-copy {
    z-index: var(--layer-hit-area);
    position: relative;
  }
  .closing-cutout .closing-image {
    display: block;
    align-self: end;
    height: auto;
    aspect-ratio: auto;
    object-fit: contain;
    pointer-events: none;
  }
  @media (min-width: 60rem) {
    .closing-cutout .closing-image {
      position: absolute;
      inset: auto 0 0 auto;
      width: 56%;
      max-height: 100%;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-surface-motion] .closing-image {
      scale: calc(1 + var(--surface-motion, 0) * var(--motion-media-zoom));
      transition: scale var(--duration-disclosure) var(--editorial-ease-out);
      transform-origin: bottom right;
    }
  }
  :global(body.home) .closing-section {
    padding-bottom: clamp(2rem, 4vw, 3.25rem);
  }
  :global(body.home) .actions :global(a) {
    border-radius: 0.5rem;
  }
  @media (min-width: 60rem) {
    :global(body.home) .closing {
      grid-template-columns: minmax(0, 55%) 1fr;
      min-height: clamp(21rem, 28vw, 24.5rem);
    }
    :global(body.home) .closing-copy {
      position: relative;
      z-index: var(--layer-hit-area);
      padding-inline-end: clamp(1.5rem, 3vw, 2.5rem);
    }
    :global(body.home) .closing-image {
      position: absolute;
      inset: auto 0 0 auto;
      width: 91%;
      height: auto;
      pointer-events: none;
    }
  }
  @media (min-width: 60rem) {
    .closing-section {
      padding-top: 0.75rem;
    }
  }
  @media (max-width: 48rem) {
    .closing {
      display: block;
    }
    .closing-copy {
      padding: clamp(1.5rem, 5vw, 2rem);
    }
    .closing .actions {
      flex-direction: column;
      align-items: stretch;
    }
    .closing .actions :global(a) {
      width: 100%;
    }
    .closing-image {
      display: block;
      height: auto;
      aspect-ratio: 2.8 / 1;
    }
    .closing-cutout .closing-image {
      width: min(100%, 34rem);
      margin-inline-start: auto;
    }
  }
  [data-density='compact'] {
    padding-block: 0 clamp(2rem, 4vw, 3.5rem);
  }
  [data-density='compact'] .closing {
    min-height: 0;
  }
  [data-density='compact'] .closing-copy {
    padding: clamp(1.25rem, 3vw, 2.5rem);
  }
  [data-density='compact'] h2 {
    font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.5rem);
  }
  @media (max-width: 48rem) {
    [data-density='compact'] .actions {
      flex-direction: row;
      align-items: center;
    }
    [data-density='compact'] .actions :global(a) {
      width: auto;
    }
    [data-density='compact'] .closing-image {
      aspect-ratio: 3.5 / 1;
    }
  }
</style>
