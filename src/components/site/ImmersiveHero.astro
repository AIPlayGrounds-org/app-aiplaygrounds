---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  image: ImageMetadata;
  title: string;
  description: string;
  align?: 'center' | 'start';
  position?: string;
  mobilePosition?: string;
  animate?: boolean;
}
const {
  id,
  image,
  title,
  description,
  align = 'center',
  position = 'center',
  mobilePosition = position,
  animate = true,
} = Astro.props;
---

<section
  {id}
  class:list={['hero', `align-${align}`]}
  data-hero-entrance={animate || undefined}
  style={{
    '--hero-position': position,
    '--hero-mobile-position': mobilePosition,
  }}
>
  <Image
    src={image}
    alt=""
    format="webp"
    widths={[480, 768, 1024, 1440]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="hero-image"
  />
  <div class="site-container hero-content">
    <h1>{title}</h1>
    <p>{description}</p>
    {Astro.slots.has('default') && (
      <div class="actions">
        <slot />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    min-height: 48rem;
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-position);
  }
  .hero-content {
    position: relative;
    text-align: center;
    padding-block: 8rem 6rem;
  }
  .hero h1 {
    max-width: 34ch;
    margin-inline: auto;
    font-size: clamp(2.25rem, 1.5rem + 2.5vw, 3.5rem);
  }
  .hero p {
    max-width: 38rem;
    font-size: clamp(1.15rem, 1rem + 0.45vw, 1.4rem);
    margin: 1.5rem auto 0;
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: center;
    margin-top: 1.5rem;
  }
  .align-start .hero-content {
    text-align: start;
  }
  .align-start h1 {
    max-width: 19ch;
    text-wrap: pretty;
  }
  .align-start p {
    max-width: 34ch;
  }
  .align-start :is(h1, p) {
    margin-inline: 0;
  }
  .align-start .actions {
    justify-content: flex-start;
    gap: 0.75rem;
  }
  @media (max-width: 60rem) {
    .align-start {
      align-items: start;
    }
    .align-start .hero-content {
      padding-top: 10rem;
    }
  }
  @media (max-width: 40rem) {
    .hero {
      min-height: 37rem;
    }
    .hero-content {
      padding-block: 6.5rem 4rem;
    }
    .hero-image {
      object-position: var(--hero-mobile-position);
    }
    .align-start .hero-content {
      padding-top: 6rem;
    }
    .align-start h1 {
      font-size: clamp(2rem, 8.3vw, 2.4rem);
      text-wrap: balance;
    }
    .align-start::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(
        ellipse 95% 35% at 7% 50%,
        color-mix(in srgb, var(--editorial-background) 46%, transparent),
        transparent
      );
      pointer-events: none;
    }
    .align-start .hero-content {
      z-index: 1;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-hero-entrance] .hero-content > :is(h1, p, .actions) {
      animation: hero-arrive 720ms var(--editorial-entrance-ease)
        var(--hero-delay, 0ms) backwards;
    }
    .hero-content > p {
      --hero-delay: 170ms;
    }
    .hero-content > .actions {
      --hero-delay: 320ms;
    }
    [data-hero-entrance] .actions:focus-within {
      animation: none;
    }
  }
  @keyframes hero-arrive {
    from {
      opacity: 0;
      translate: 0 23px;
    }
  }
</style>
