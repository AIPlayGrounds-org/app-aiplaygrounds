---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  image: ImageMetadata;
  title: string;
  description: string;
  align?: 'center' | 'start';
  composition?: 'standard' | 'open-sky';
  position?: string;
  mobilePosition?: string;
  imageSizes?: string;
  animate?: boolean;
}
const {
  id,
  image,
  title,
  description,
  align = 'center',
  composition = 'standard',
  position = 'center',
  mobilePosition = position,
  imageSizes = '100vw',
  animate = true,
} = Astro.props;
---

<section
  {id}
  class:list={[
    'hero',
    `align-${align}`,
    { 'open-sky': composition === 'open-sky' },
  ]}
  data-hero-entrance={animate || undefined}
  style={{
    '--hero-position': position,
    '--hero-mobile-position': mobilePosition,
  }}
>
  <Image
    src={image}
    alt=""
    format="webp"
    widths={[480, 768, 1024, 1440]}
    sizes={imageSizes}
    loading="eager"
    fetchpriority="high"
    class="hero-image"
  />
  <div class="site-container hero-content">
    <h1>{title}</h1>
    <p>{description}</p>
    {Astro.slots.has('default') && (
      <div class="actions">
        <slot />
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    min-height: 48rem;
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--hero-position);
  }
  .hero-content {
    position: relative;
    text-align: center;
    padding-block: 8rem 6rem; /* design-exception: Reserva de cielo entre cabecera y horizonte en escritorio. */
  }
  .hero h1 {
    max-width: 34ch;
    margin-inline: auto;
    font-size: clamp(2.25rem, 1.5rem + 2.5vw, 3.5rem);
  }
  .hero p {
    max-width: 38rem;
    font-size: clamp(1.15rem, 1rem + 0.45vw, 1.4rem);
    margin: calc(var(--space-unit) * 6) auto 0;
  }
  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-control) calc(var(--space-unit) * 6);
    justify-content: center;
    margin-top: calc(var(--space-unit) * 6);
  }
  .align-start .hero-content {
    text-align: start;
  }
  .align-start h1 {
    max-width: 19ch;
    text-wrap: pretty;
  }
  .align-start p {
    max-width: 34ch;
  }
  .align-start :is(h1, p) {
    margin-inline: 0;
  }
  .align-start .actions {
    justify-content: flex-start;
    gap: var(--space-control);
  }
  .hero.open-sky {
    /* Centra el texto en el cielo entre la navegación y el horizonte. */
    grid-template-rows:
      var(--site-header-height) minmax(max-content, 3fr)
      minmax(0, 1fr);
  }
  .hero.open-sky .hero-content {
    grid-row: 2;
    place-self: center;
    padding-block: 0;
  }
  .open-sky h1 {
    max-width: 20ch;
    text-wrap: balance;
  }
  .open-sky p {
    max-width: 42ch;
    margin-top: var(--space-stack);
  }
  .open-sky .actions {
    margin-top: var(--space-card);
  }
  @media (max-width: 60rem) {
    .align-start {
      align-items: start;
    }
    .align-start .hero-content {
      padding-top: 10rem; /* design-exception: Reserva de cielo para el encuadre del hero en móvil. */
    }
  }
  @media (max-width: 40rem) {
    .hero {
      min-height: 37rem;
    }
    .hero-content {
      padding-block: 6.5rem 4rem; /* design-exception: Ajuste del bloque de texto a la escena en pantallas estrechas. */
    }
    .hero-image {
      object-position: var(--hero-mobile-position);
    }
    .align-start .hero-content {
      padding-top: 6rem; /* design-exception: Reserva de cielo específica de la composición en móvil. */
    }
    .align-start h1 {
      font-size: clamp(2rem, 8.3vw, 2.4rem);
      text-wrap: balance;
    }
    .open-sky h1 {
      font-size: clamp(1.875rem, 1.45rem + 2vw, 2.25rem);
    }
    .open-sky p {
      font-size: var(--type-control);
    }
  }
  .open-sky .hero-image {
    transform-origin: center bottom;
  }
</style>

<script>
  import { allowMotion } from '../../motion/preferences';
  if (allowMotion() && document.querySelector('[data-hero-entrance]')) {
    void import('../../motion/hero')
      .then(({ immersiveEntrance }) => {
        if (!allowMotion()) return;
        for (const hero of document.querySelectorAll<HTMLElement>(
          '[data-hero-entrance]',
        )) {
          if (hero.getBoundingClientRect().bottom > 0) immersiveEntrance(hero);
        }
      })
      .catch(() => {
        /* The hero is already visible. */
      });
  }
</script>
