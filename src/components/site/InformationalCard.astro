---
import Card from '../starwind/card/Card.astro';

interface Props {
  title: string;
  description: string;
  layout?: 'stacked' | 'inline';
  tone?: 'warm' | 'grove' | 'sand' | 'lilac' | 'rose';
}
const { title, description, layout = 'stacked', tone = 'warm' } = Astro.props;
---

<Card
  class:list={['info-card gap-0 p-0 ring-0', layout, `tone-${tone}`]}
  data-card-outline
>
  <div class="motif">
    <slot name="icon" />
  </div>
  <div>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</Card>

<style>
  .info-card {
    --info-surface: var(--editorial-surface);
    --info-ink: var(--editorial-grove-ink);
    --card-edge-active: var(--info-ink);
    display: grid;
    align-content: start;
    gap: 0.85rem;
    height: 100%;
    padding: clamp(1.125rem, 2.5vw, 2rem);
    border-radius: var(--editorial-radius);
    background: var(--info-surface);
  }
  .info-card.inline {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    gap: 1rem;
  }
  .info-card:not(.tone-warm) {
    --card-edge-rest: color-mix(
      in srgb,
      var(--info-ink) 32%,
      var(--info-surface)
    );
  }
  .tone-grove {
    --info-surface: var(--editorial-grove);
  }
  .tone-sand {
    --info-surface: var(--editorial-sand);
    --info-ink: var(--editorial-sand-ink);
  }
  .tone-lilac {
    --info-surface: var(--editorial-lilac);
    --info-ink: var(--editorial-lilac-ink);
  }
  .tone-rose {
    --info-surface: #ead8d2;
    --info-ink: #704c43;
  }
  .motif {
    color: var(--info-ink);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .info-card:hover .motif :global(path) {
      stroke-dasharray: 1 1;
      animation: draw-motif 1000ms linear backwards;
    }
    .info-card:hover .motif :global(path:nth-child(2)) {
      animation-delay: 120ms;
    }
    .info-card:hover .motif :global(path:nth-child(3)) {
      animation-delay: 240ms;
    }
    .info-card:hover .motif :global(path:nth-child(n + 4)) {
      animation-delay: 360ms;
    }
  }
  @keyframes draw-motif {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  h3 {
    font-size: clamp(1.2rem, 1.12rem + 0.35vw, 1.45rem);
  }
  p {
    margin-top: 0.4rem;
    max-width: 42ch;
    color: var(--secondary-text);
  }
</style>
