---
import { Plus } from '@lucide/astro';
import Dropdown from '../ui/Dropdown.astro';
import Button from '../ui/Button.astro';

interface Props {
  immersive?: boolean;
}
const { immersive = false } = Astro.props;
const links = [
  ['Comunidad', '/comunidad/'],
  ['Formación', '/formacion/'],
  ['AI Labs', '/ai-labs/'],
  ['Investigación', '/investigacion/'],
  ['Equipo', '/equipo/'],
];
const audience = [
  ['Personas', '/'],
  ['Empresas', '/empresas/'],
];
const pathname = Astro.url.pathname;
const organizations = pathname === '/empresas/';
const cta = organizations
  ? { label: 'Ver opciones', href: '#EM2' }
  : { label: 'Ver comunidad', href: '/comunidad/#C4' };
---

<span class="header-sentinel" data-header-sentinel aria-hidden="true"></span>
<header class="site-header" data-immersive={immersive || undefined}>
  <div class="site-container header-inner">
    <a href="/" class="brand" translate="no">
      <img
        src="/logo-ai-playgrounds.svg"
        alt="AI PlayGrounds"
        width="545"
        height="135"
      />
    </a>
    <nav class="audience-nav desktop-nav" aria-label="Recorridos">
      {audience.map(([label, href]) => (
        <a href={href} aria-current={pathname === href ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>
    <nav class="desktop-nav" aria-label="Navegación principal">
      {links.map(([label, href]) => (
        <a href={href} aria-current={pathname === href ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>
    <div class="desktop-cta">
      <Button
        href={cta.href}
        variant="primary"
        data-cta={organizations ? 'header_opportunities' : undefined}
      >
        {cta.label}
      </Button>
    </div>
    <Dropdown class="mobile-nav">
      <summary slot="trigger">
        Menú{' '}
        <span aria-hidden="true" class="menu-icon">
          <Plus class="size-icon-chevron" />
        </span>
      </summary>
      <nav slot="panel" aria-label="Navegación móvil">
        <div class="mobile-audience">
          {audience.map(([label, href]) => (
            <a
              href={href}
              aria-current={pathname === href ? 'page' : undefined}
            >
              {label}
            </a>
          ))}
        </div>
        {links.map(([label, href]) => (
          <a href={href} aria-current={pathname === href ? 'page' : undefined}>
            {label}
          </a>
        ))}
        <div class="mobile-cta">
          <Button
            href={cta.href}
            variant="primary"
            data-cta={organizations ? 'header_opportunities' : undefined}
          >
            {cta.label}
          </Button>
        </div>
      </nav>
    </Dropdown>
  </div>
</header>
<script>
  const sentinel = document.querySelector('[data-header-sentinel]');
  const header = document.querySelector('.site-header');
  if (sentinel && header && 'IntersectionObserver' in window) {
    const update = () => {
      const atTop = window.scrollY <= 0;
      header.toggleAttribute('data-at-top', atTop);
      header.toggleAttribute('data-scrolled', !atTop);
    };
    update();
    new IntersectionObserver(update, { threshold: 1 }).observe(sentinel);
    window.addEventListener('pageshow', update);
  }

  document
    .querySelectorAll<HTMLDetailsElement>('.mobile-nav')
    .forEach((menu) => {
      menu.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu.open) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
      menu.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const link = event.target.closest<HTMLAnchorElement>('nav a');
        if (link?.pathname !== location.pathname || !link.hash) return;
        menu.open = false;
        menu.querySelector('summary')?.focus({ preventScroll: true });
      });
    });
</script>
<style>
  .site-header {
    position: sticky;
    inset-inline: 0;
    inset-block-start: 0;
    z-index: var(--layer-sticky);
    margin-block-end: calc(-1 * var(--site-header-height));
    color: var(--brand-black);
    background: var(--editorial-background);
  }
  .site-header[data-immersive][data-at-top] {
    background: transparent;
  }
  .site-header[data-scrolled] {
    box-shadow: inset 0 calc(-1 * var(--stroke-default)) var(--line); /* design-exception: Borde interior sin cambiar la altura de la cabecera fija. */
  }
  .header-sentinel {
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    block-size: 1px;
    inline-size: 1px;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .site-header {
      transition: background-color var(--duration-feedback)
        var(--motion-ease-standard);
    }
  }
  .header-inner {
    min-height: var(--site-header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-stack);
  }
  .brand {
    display: block;
    flex: none;
  }
  .brand img {
    inline-size: 9.5rem;
    block-size: auto;
  }
  :global(body.academy) .site-header[data-at-top] .brand {
    background: var(--editorial-background);
    border-radius: var(--editorial-radius);
  }
  .desktop-nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-inline) var(--space-stack);
  }
  .desktop-nav a {
    font-size: var(--type-label);
    font-weight: var(--weight-medium);
    text-decoration: none;
    padding-block: var(--space-control);
  }
  .desktop-nav a:hover {
    text-decoration: underline;
  }
  .desktop-nav a[aria-current='page'],
  .mobile-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
  .audience-nav {
    margin-inline-end: auto;
  }
  .mobile-nav {
    display: none;
    position: static;
  }
  .mobile-nav:not([open]) nav {
    display: none;
  }
  @media (max-width: 67rem) {
    .desktop-cta,
    .desktop-nav {
      display: none;
    }
    .mobile-nav {
      display: block;
    }
    .mobile-nav summary {
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: var(--space-control);
      min-height: 44px;
      font-weight: var(--weight-medium);
      list-style: none;
    }
    .mobile-nav summary::-webkit-details-marker {
      display: none;
    }
    .menu-icon {
      display: grid;
      place-items: center;
      width: 2rem;
      height: 2rem;
      border: var(--stroke-default) solid var(--foreground);
    }
    .mobile-nav nav {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      display: grid;
      background: var(--home-background, var(--background));
      padding: var(--space-stack) var(--layout-gutter)
        calc(var(--space-unit) * 6);
      border-bottom: var(--stroke-default) solid var(--input);
      max-height: calc(100dvh - var(--site-header-height));
      overflow-y: auto;
    }
    .mobile-audience {
      padding-bottom: var(--space-control);
      margin-bottom: var(--space-control);
      border-bottom: var(--stroke-emphasis) solid var(--foreground);
    }
    .mobile-nav nav a:not([data-slot='button']) {
      display: block;
      min-height: 44px;
      padding: var(--space-control) var(--space-inline);
      text-decoration: none;
      border-bottom: var(--stroke-default) solid var(--line);
    }
    .mobile-nav nav a[aria-current='page']:not([data-slot='button']) {
      text-decoration: underline;
      background: var(--home-surface, var(--surface));
    }
    .mobile-nav[open] .menu-icon :global(svg) {
      rotate: 45deg;
    }
    @media (prefers-reduced-motion: no-preference) {
      .mobile-nav .menu-icon :global(svg) {
        transition: rotate var(--duration-control) var(--editorial-ease-out);
      }
    }
    .mobile-cta {
      margin-top: var(--space-stack);
    }
  }
</style>
