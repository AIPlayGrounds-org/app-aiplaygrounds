---
import Card from '../ui/Card.astro';
import InitiativeArt from './InitiativeArt.astro';
import SceneMotion from './SceneMotion.astro';
import TextLink from './TextLink.astro';

interface Props {
  id?: string;
  illustrationId: string;
  illustration: 'labs' | 'academy' | 'organizations' | 'research';
  title: string;
  description: string;
  href: string;
  label: string;
  ctaId?: string;
  inquiryType?: 'institutional' | 'commercial';
}
const {
  id,
  illustrationId,
  illustration,
  title,
  description,
  href,
  label,
  ctaId,
  inquiryType,
} = Astro.props;
---

<Card
  as="article"
  surface="inherit"
  density="none"
  edge="none"
  interaction="single-link"
  {id}
  class={`path-card path-${illustration}`}
  data-scene="signal"
  tabindex={id ? -1 : undefined}
>
  <div class="path-illustration" aria-hidden="true">
    <InitiativeArt id={illustrationId} variant={illustration} />
  </div>
  <h3 data-scene-title>{title}</h3>
  <p data-scene-copy>{description}</p>
  <TextLink
    {href}
    data-cta={ctaId}
    data-inquiry-type={inquiryType}
    data-card-link
    data-scene-actions
  >
    {label}
  </TextLink>
</Card>
<SceneMotion />

<style>
  .path-card {
    --path-inset: clamp(1.125rem, 2vw, 1.625rem);
    --path-wash: var(--editorial-grove);
    --path-ink: var(--editorial-grove-ink);
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    min-inline-size: 0;
    border: var(--stroke-default) solid var(--card-edge);
    border-radius: var(--editorial-radius);
    background: var(--editorial-card);
  }
  .path-academy {
    --path-wash: var(--editorial-sand);
    --path-ink: var(--editorial-sand-ink);
  }
  .path-organizations,
  .path-research {
    --path-wash: var(--editorial-lilac);
    --path-ink: var(--editorial-lilac-ink);
  }
  .path-illustration {
    display: grid;
    place-items: center;
    overflow: hidden;
    block-size: clamp(8rem, 13vw, 11rem);
    border-radius: var(--editorial-radius) var(--editorial-radius) 0 0;
    border-block-end: var(--stroke-default) solid var(--line);
    background: var(--path-wash);
    color: var(--path-ink);
  }
  .path-card > :is(h3, p, :global(a)) {
    margin-inline: var(--path-inset);
  }
  .path-card h3 {
    margin-block-start: var(--path-inset);
    text-wrap: pretty;
    font-size: var(--type-card-title);
  }
  .path-card p {
    margin-block-start: var(--space-related);
    color: var(--secondary-text);
  }
  .path-card :global(.text-link) {
    justify-self: start;
    margin-block: var(--space-control) var(--space-control);
  }
  @media (min-width: 52rem) {
    @supports (grid-template-rows: subgrid) {
      .path-card {
        grid-row: span 4;
        grid-template-rows: subgrid;
      }
    }
  }
</style>
