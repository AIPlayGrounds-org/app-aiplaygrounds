---
import CompactHeroArt from './CompactHeroArt.astro';
import { type CompactHeroVariant } from './compact-hero-art';

interface Props {
  id: string;
  title: string;
  description: string;
  variant: CompactHeroVariant;
}
const { id, title, description, variant } = Astro.props;
---

<section {id} class="compact-hero" data-variant={variant}>
  <div class="site-container hero-layout">
    <div class="hero-copy">
      <h1>{title}</h1>
      <p>{description}</p>
    </div>
    <div class="hero-art" aria-hidden="true">
      <CompactHeroArt {id} {variant} />
    </div>
  </div>
</section>

<style>
  /* The sticky header's negative margin is intentional for immersive pages.
     Reserve its height only in layouts that use this opening. */
  :global(main#contenido):has(> .compact-hero) {
    padding-block-start: var(--site-header-height);
  }
  .compact-hero {
    background: var(--editorial-background);
    border-block-end: 1px solid
      color-mix(in srgb, var(--border) 55%, var(--editorial-background));
  }
  .hero-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.13fr) minmax(0, 1fr);
    align-items: center;
    min-block-size: clamp(17.5rem, 24vw, 21.25rem);
    position: relative;
  }
  .hero-copy {
    padding-block: 2rem;
  }
  h1 {
    max-inline-size: 24ch;
    font-size: clamp(2.125rem, 1.2rem + 2.35vw, 3.5rem);
    overflow-wrap: break-word;
  }
  p {
    max-inline-size: 49ch;
    margin-block-start: 1rem;
    color: var(--secondary-text);
    font-size: clamp(1.0625rem, 0.96rem + 0.33vw, 1.25rem);
  }
  .hero-art {
    position: absolute;
    inset-block: 0;
    inset-inline: 53% 0;
    pointer-events: none;
    overflow: clip;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 13%,
      #000 93%,
      transparent
    );
  }
  @media (max-width: 46rem) {
    .hero-layout {
      grid-template-columns: minmax(0, 1fr);
      min-block-size: auto;
    }
    .hero-copy {
      padding-block: clamp(1.5rem, 5vw, 2.25rem) 0.45rem;
    }
    .hero-art {
      position: relative;
      inset: auto;
      block-size: clamp(5.75rem, 20vw, 8rem);
      mask-image: linear-gradient(
        to right,
        transparent,
        #000 32%,
        #000 93%,
        transparent
      );
    }
  }
</style>

<script>
  // A normal visit creates new CSS animations. A back/forward cache restore
  // keeps the same document, including already finished animations.
  window.addEventListener('pageshow', ({ persisted }) => {
    if (!persisted) return;

    for (const art of document.querySelectorAll('.compact-hero .hero-art')) {
      for (const animation of art.getAnimations({ subtree: true })) {
        animation.currentTime = 0;
        animation.play();
      }
    }
  });
</script>
