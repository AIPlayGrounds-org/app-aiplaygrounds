---
import { compactHeroArt, type CompactHeroVariant } from './compact-hero-art';

interface Props {
  id: string;
  variant: CompactHeroVariant;
}
const { id, variant } = Astro.props;
const {
  palette: [ink, mid, light],
  land,
  contours,
  grid: [gx, gy, gw, gh],
  dots: [dx, dy, dw, dh],
  routes,
  points,
  terminals = [],
} = compactHeroArt[variant];
const artId = (part: string) => `${id}-art-${part}`;
const paint = (part: string) => `url(#${artId(part)})`;
const step = (index: number) => ({ '--step': index });
const landColors = [light, mid, ink];
const landOpacity = [0.64, 0.48, 0.35];
const dotSize = 13;
// Divide the reference pattern into strips on its tile boundaries so that
// the matrix can enter in rows without moving or cutting any dots.
const dotRows = Array.from(
  { length: Math.ceil((dy + dh) / dotSize) - Math.floor(dy / dotSize) },
  (_, index) => {
    const tileY = (Math.floor(dy / dotSize) + index) * dotSize;
    const y = Math.max(dy, tileY);
    return { y, height: Math.min(dy + dh, tileY + dotSize) - y };
  },
);
---

<svg
  viewBox="0 0 1440 340"
  preserveAspectRatio="xMidYMax slice"
  aria-hidden="true"
  focusable="false"
  style={{ color: ink }}
>
  <defs>
    <linearGradient id={artId('fade')}>
      <stop offset=".42" stop-color="white" stop-opacity="0" />
      <stop offset=".60" stop-color="white" stop-opacity=".4" />
      <stop offset=".84" stop-color="white" />
    </linearGradient>
    <mask
      id={artId('surface')}
      maskUnits="userSpaceOnUse"
      x="0"
      y="0"
      width="1440"
      height="340"
    >
      <rect width="1440" height="340" fill={paint('fade')} />
    </mask>
    <radialGradient id={artId('grid-fade')}>
      <stop offset="0" stop-color="white" />
      <stop offset=".64" stop-color="white" stop-opacity=".64" />
      <stop offset="1" stop-color="white" stop-opacity="0" />
    </radialGradient>
    <mask
      id={artId('grid-mask')}
      maskUnits="userSpaceOnUse"
      x={gx}
      y={gy}
      width={gw}
      height={gh}
    >
      <rect x={gx} y={gy} width={gw} height={gh} fill={paint('grid-fade')} />
    </mask>
    <pattern
      id={artId('grid')}
      width="31"
      height="31"
      patternUnits="userSpaceOnUse"
    >
      <path
        d="M31 0H0V31"
        fill="none"
        stroke="currentColor"
        stroke-width=".6"
        opacity=".21"
      />
    </pattern>
    <pattern
      id={artId('dots')}
      width={dotSize}
      height={dotSize}
      patternUnits="userSpaceOnUse"
    >
      <circle cx="3" cy="3" r="1.15" fill="currentColor" opacity=".56" />
    </pattern>
  </defs>
  <g mask={paint('surface')}>
    {land.map((d, i) => (
      <path
        class="land"
        {d}
        fill={landColors[i]}
        fill-opacity={landOpacity[i]}
        style={step(i)}
      />
    ))}
    <g class="grid" mask={paint('grid-mask')}>
      <rect x={gx} y={gy} width={gw} height={gh} fill={paint('grid')} />
    </g>
    <g
      class="contours"
      fill="none"
      stroke="currentColor"
      stroke-width=".8"
      opacity=".54"
    >
      {contours.map((d, i) => (
        <path {d} pathLength="1" style={step(i)} />
      ))}
    </g>
    <g
      class="marks"
      fill="none"
      stroke="currentColor"
      stroke-width=".95"
      opacity=".63"
    >
      {routes.map((d, i) => (
        <path {d} pathLength="1" style={step(i)} />
      ))}
      {terminals.map(([x, y, width, height], i) => (
        <rect {x} {y} {width} {height} style={step(i)} />
      ))}
      {points.map(([cx, cy, r], i) => (
        <circle {cx} {cy} {r} style={step(terminals.length + i)} />
      ))}
    </g>
    {dotRows.map(({ y, height }, i) => (
      <rect
        class="dot-row"
        x={dx}
        {y}
        width={dw}
        {height}
        fill={paint('dots')}
        style={step(i)}
      />
    ))}
  </g>
</svg>

<style>
  svg {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .land {
      transform-box: fill-box;
      transform-origin: bottom;
      animation: land-rise 1.15s var(--editorial-entrance-ease) both;
      animation-delay: calc(160ms * var(--step));
    }
    .contours path {
      animation: line-draw 1.25s ease-out both;
      animation-delay: calc(350ms + 55ms * var(--step));
    }
    .marks path {
      animation: line-draw 0.72s ease-out both;
      animation-delay: calc(1000ms + 85ms * var(--step));
    }
    .grid {
      animation: appear 0.65s ease-out 1.05s both;
    }
    .marks :is(circle, rect) {
      animation: appear 0.5s ease-out both;
      animation-delay: calc(1380ms + 75ms * var(--step));
    }
    .dot-row {
      animation: appear 0.65s ease-out both;
      animation-delay: calc(1450ms + 45ms * var(--step));
    }
  }
  @keyframes land-rise {
    from {
      opacity: 0;
      transform: translateY(26px) scaleY(0.86);
    }
  }
  @keyframes line-draw {
    from {
      stroke-dasharray: 1 1;
      stroke-dashoffset: 1;
    }
    to {
      stroke-dasharray: 1 1;
      stroke-dashoffset: 0;
    }
  }
  @keyframes appear {
    from {
      opacity: 0;
    }
  }
</style>
