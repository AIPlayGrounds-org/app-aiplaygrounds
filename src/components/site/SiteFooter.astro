---
import { Image } from 'astro:assets';
import { inicioImages } from '../../assets/inicio';

interface Props {
  reveal?: boolean;
}
const { reveal = false } = Astro.props;

const groups = [
  {
    title: 'Organización',
    links: [
      ['Comunidad', '/comunidad/'],
      ['Equipo', '/equipo/'],
      ['Empresas', '/empresas/'],
    ],
  },
  {
    title: 'Iniciativas',
    links: [
      ['Formación', '/formacion/'],
      ['AI Labs', '/ai-labs/'],
    ],
  },
  {
    title: 'Explorar',
    links: [
      ['Productos', '/ai-labs/#B3'],
      ['Investigación', '/investigacion/'],
    ],
  },
];
---

<footer class="footer">
  <div
    class="site-container footer-inner"
    data-reveal={reveal ? '' : undefined}
  >
    <div class="footer-intro">
      <a class="footer-brand" href="/" translate="no">
        <img
          src="/logo-ai-playgrounds.svg"
          alt="AI PlayGrounds"
          width="545"
          height="135"
        />
      </a>
      <p>
        AI PlayGrounds es una organización enfocada en inteligencia artificial,
        impulsada por su comunidad.
      </p>
      <p class="copyright">
        © 2026 Fundación AI PlayGrounds. Todos los derechos reservados.
      </p>
    </div>
    <nav aria-label="Navegación del pie de página">
      {groups.map(({ title, links }) => (
        <div>
          <h2>{title}</h2>
          {links.map(([label, href]) => (
            <a href={href}>{label}</a>
          ))}
        </div>
      ))}
    </nav>
  </div>
  <div class="landscape-frame" data-reveal={reveal ? 'ink' : undefined}>
    <Image
      src={inicioImages.footer}
      alt=""
      format="webp"
      widths={[480, 768, 1024, 1440, 2092]}
      sizes="(max-width: 650px) 650px, 100vw"
      loading="lazy"
      class="landscape"
    />
  </div>
</footer>
<style>
  .footer {
    background: var(--home-surface, var(--background));
    border-block-start: var(--stroke-default) solid var(--line);
    overflow: hidden;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 3rem;
    padding-block: 3rem 0.5rem;
  }
  .footer-intro {
    max-width: 24rem;
  }
  .footer-brand {
    display: inline-block;
    max-inline-size: 100%;
  }
  .footer-brand img {
    inline-size: 13rem;
    block-size: auto;
  }
  .footer-intro p {
    font-size: var(--type-label);
    margin-top: var(--space-stack);
    color: var(--secondary-text);
  }
  .footer-intro .copyright {
    margin-block-start: var(--space-control);
    font-size: var(--type-caption);
    color: var(--muted-foreground);
  }
  nav {
    display: grid;
    grid-template-columns: repeat(3, minmax(6rem, 1fr));
    gap: clamp(2rem, 5vw, 6rem);
  }
  nav h2 {
    font: 500 0.875rem var(--font-sans);
    margin: 0 0 1rem;
  }
  nav a {
    display: block;
    font-size: var(--type-label);
    margin-block: 0.75rem;
    color: var(--secondary-text);
    text-decoration: none;
  }
  nav a:hover {
    text-decoration: underline;
  }
  .landscape-frame {
    position: relative;
    overflow: hidden;
    height: clamp(8rem, 13vw, 13rem);
    pointer-events: none;
  }
  .landscape {
    position: absolute;
    display: block;
    width: max(100%, 650px);
    max-width: none;
    height: auto;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
  }
  @media (min-width: 48.01rem) {
    .footer-inner {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      gap: clamp(1.5rem, 4vw, 3rem);
      padding-top: clamp(3rem, 4vw, 3.75rem);
    }
    nav {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: clamp(1rem, 3vw, 3rem);
    }
  }
  @media (max-width: 48rem) {
    .footer-inner {
      flex-direction: column;
    }
    nav {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-stack);
    }
  }
  @media (max-width: 23rem) {
    nav {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
