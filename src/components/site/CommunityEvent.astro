---
import { CalendarDays, Users } from '@lucide/astro';
import type { CollectionEntry } from 'astro:content';
import TextLink from './TextLink.astro';

interface Props {
  event: CollectionEntry<'communityEvents'>['data'];
  featured?: boolean;
  inHistory?: boolean;
}

const { event, featured = false, inHistory = false } = Astro.props;
const Heading = inHistory ? 'h4' : 'h3';
const start = new Date(event.startAt);
const options = { timeZone: event.timezone ?? 'UTC' };
const date = new Intl.DateTimeFormat('es-PE', {
  ...options,
  dateStyle: 'medium',
}).format(start);
const time = new Intl.DateTimeFormat('es-PE', {
  ...options,
  timeStyle: 'short',
}).format(start);
const month = new Intl.DateTimeFormat('es-PE', { ...options, month: 'short' })
  .format(start)
  .replace(/\.$/, '');
const day = new Intl.DateTimeFormat('es-PE', {
  ...options,
  day: '2-digit',
}).format(start);
const cover = featured ? event.cover : event.thumb;
const description = event.description?.replace(/\s+/g, ' ').trim();
const excerpt =
  description && description.length > 245
    ? (() => {
        let result = '';
        for (const { segment } of new Intl.Segmenter('es', {
          granularity: 'sentence',
        }).segment(description)) {
          if ((result + segment).length > 245) break;
          result += segment;
        }
        return (
          result.trim() ||
          `${description.slice(0, 245).replace(/\s+\S*$/, '')}…`
        );
      })()
    : description;
---

<article
  class:list={[featured ? 'featured' : 'event-row', { 'has-cover': cover }]}
  data-card-interactive
  data-card-hit-area
  data-reveal={featured ? 'card' : 'ink'}
>
  {!featured && (
    <div class="date-stamp" aria-hidden="true">
      <span>{month}</span>
      <strong>{day}</strong>
    </div>
  )}
  {cover && (
    <img
      src={cover}
      alt=""
      width={featured ? 800 : 240}
      height={featured ? 800 : 240}
      loading="lazy"
      decoding="async"
    />
  )}
  <div class="event-copy">
    {featured && <p class="featured-label">Encuentro destacado</p>}
    <Heading>{event.title}</Heading>
    <div class="event-details">
      <p>
        <CalendarDays size={17} aria-hidden="true" />
        <span>
          <time datetime={event.startAt}>
            {date} · {time}
            {!event.timezone && ' UTC'}
          </time>
          {event.modality && ` · ${event.modality}`}
          {event.city && ` · ${event.city}`}
        </span>
      </p>
      {event.organizers.length > 0 && (
        <p>
          <Users size={17} aria-hidden="true" />
          <span>{event.organizers.join(' · ')}</span>
        </p>
      )}
    </div>
    {featured && excerpt && <p class="excerpt">{excerpt}</p>}
    {featured && (
      <TextLink
        class="event-link"
        href={event.url}
        target="_blank"
        rel="noopener"
        data-card-link
      >
        Ver evento en Luma
        <span class="sr-only">: {event.title} (abre en una pestaña nueva)</span>
      </TextLink>
    )}
  </div>
  {!featured && (
    <TextLink
      class="event-link"
      href={event.url}
      target="_blank"
      rel="noopener"
      data-card-link
    >
      Ver evento en Luma
      <span class="sr-only">: {event.title} (abre en una pestaña nueva)</span>
    </TextLink>
  )}
</article>

<style>
  article {
    display: grid;
    min-width: 0;
  }
  .featured {
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    margin-block-start: clamp(1rem, 2vw, 1.5rem);
    background: var(--home-surface);
    border: var(--stroke-default) solid var(--card-edge, var(--line));
    border-radius: var(--radius-large);
  }
  .featured.has-cover {
    grid-template-columns: minmax(0, 34%) minmax(0, 1fr);
  }
  img {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1;
    object-fit: contain;
    background: var(--home-card);
  }
  .featured img {
    border-radius: var(--radius-large) 0 0 var(--radius-large);
  }
  .featured .event-copy {
    padding-block: clamp(1.5rem, 3.2vw, 2.75rem);
    padding-inline: clamp(1.25rem, 3vw, 2.5rem);
  }
  .featured-label {
    margin-block-end: 0.55rem;
    color: var(--community-accent);
    font: 500 0.8125rem / 1.4 var(--font-mono);
    letter-spacing: 0.075em;
    text-transform: uppercase;
  }
  .featured h3 {
    font-size: clamp(1.65rem, 1.26rem + 1.3vw, 2.25rem);
  }
  .event-copy {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .event-details {
    display: grid;
    gap: 0.35rem;
    margin-block-start: 0.55rem;
    color: var(--secondary-text);
    line-height: var(--leading-compact);
  }
  .event-details p {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }
  .event-details svg {
    flex: none;
    margin-block-start: 0.1em;
  }
  .excerpt {
    margin-block-start: 0.9rem;
    max-width: var(--measure-reading);
    color: var(--secondary-text);
  }
  article :global(.event-link) {
    justify-self: start;
  }
  .featured :global(.event-link) {
    margin-block-start: 0.35rem;
  }
  .event-row {
    border-block-end: var(--stroke-default) solid var(--card-edge);
    grid-template-columns: var(--date-size) minmax(0, 1fr) max-content;
    column-gap: clamp(0.8rem, 2.8vw, 2.2rem);
    align-items: center;
    padding-block: 0.9rem;
    --date-size: clamp(3.3rem, 9vw, 6.4rem);
    --thumb-size: clamp(3.6rem, 8vw, 5.75rem);
  }
  .event-row.has-cover {
    grid-template-columns:
      var(--date-size) var(--thumb-size) minmax(0, 1fr)
      max-content;
  }
  .event-row :is(h3, h4) {
    font-family: var(--font-heading);
    font-size: clamp(1.12rem, 1rem + 0.42vw, 1.375rem);
    font-weight: var(--weight-heading);
    line-height: var(--leading-title);
    letter-spacing: -0.025em;
  }
  .event-row:focus-within :is(h3, h4, .date-stamp) {
    color: var(--interaction-accent);
  }
  @media (hover: hover) and (pointer: fine) {
    .event-row:hover :is(h3, h4, .date-stamp) {
      color: var(--interaction-accent);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .event-row :is(h3, h4, .date-stamp) {
      transition: color var(--editorial-response) var(--editorial-ease-out);
    }
  }
  .event-row img {
    border-radius: var(--editorial-radius);
  }
  .date-stamp {
    display: grid;
    justify-items: center;
    padding-block: 0.35rem;
    border-inline-end: var(--stroke-default) solid var(--line);
    font-family: var(--font-heading);
    font-variant-numeric: tabular-nums;
    line-height: var(--leading-heading);
  }
  .date-stamp span {
    text-transform: uppercase;
    font-size: var(--type-caption);
    letter-spacing: 0.08em;
  }
  .date-stamp strong {
    font-size: clamp(1.4rem, 2.7vw, 2rem);
  }
  @media (max-width: 50rem) {
    .event-row {
      grid-template-columns: var(--date-size) minmax(0, 1fr);
    }
    .event-row.has-cover {
      grid-template-columns: var(--date-size) var(--thumb-size) minmax(0, 1fr);
    }
    .event-row :global(.event-link) {
      grid-column: 2;
    }
    .event-row.has-cover :global(.event-link) {
      grid-column: 3;
    }
  }
  @media (max-width: 36rem) {
    .featured.has-cover {
      grid-template-columns: minmax(0, 1fr);
    }
    .featured img {
      border-radius: var(--radius-large) var(--radius-large) 0 0;
    }
    .event-row.has-cover {
      grid-template-columns: var(--date-size) minmax(0, 1fr);
      align-items: start;
    }
    .event-row.has-cover img {
      inline-size: min(100%, var(--thumb-size));
      grid-column: 1;
      grid-row: 2 / span 2;
      margin-block-start: 0.45rem;
    }
    .event-row.has-cover .event-copy {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
    .event-row.has-cover :global(.event-link) {
      grid-column: 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    article[data-card-interactive] {
      transition: none;
    }
  }
</style>
