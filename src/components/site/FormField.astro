---
interface Props {
  id: string;
  name: string;
  label: string;
  kind?: 'text' | 'email' | 'textarea' | 'select';
  autocomplete?: 'name' | 'organization' | 'email';
  maxLength?: number;
  placeholder?: string;
  error: string;
  class?: string;
}
const {
  id,
  name,
  label,
  kind = 'text',
  autocomplete,
  maxLength,
  placeholder,
  error,
  class: className,
} = Astro.props;
const errorId = `${id}-error`;
---

<div class:list={['form-field', className]}>
  <label for={id}>
    {label} <span aria-hidden="true">*</span>
  </label>
  {kind === 'select' ? (
    <select
      {id}
      {name}
      required
      aria-invalid="false"
      data-error={errorId}
      data-required-message={error}
    >
      <slot />
    </select>
  ) : kind === 'textarea' ? (
    <textarea
      {id}
      {name}
      {placeholder}
      maxlength={maxLength}
      rows="4"
      required
      aria-invalid="false"
      data-error={errorId}
      data-required-message={error}
    ></textarea>
  ) : (
    <input
      {id}
      {name}
      {autocomplete}
      {placeholder}
      type={kind}
      maxlength={maxLength}
      required
      aria-invalid="false"
      data-error={errorId}
      data-required-message={error}
    />
  )}
  <p id={errorId} data-field-error hidden>
    {error}
  </p>
</div>

<style>
  .form-field {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    min-width: 0;
  }
  label {
    font-weight: 500;
  }
  :is(input, select, textarea) {
    width: 100%;
    min-height: 3rem;
    padding: 0.65rem 0.75rem;
    font: inherit;
    font-size: max(1rem, 1em);
    color: var(--foreground);
    background: var(--editorial-background);
    border: 1px solid var(--input);
    border-radius: 0.25rem;
    transition:
      border-color 150ms ease-out,
      background-color 150ms ease-out;
  }
  select {
    appearance: auto;
  }
  @media (max-width: 22rem) {
    select {
      padding-inline: 0.375rem;
      font-size: 1rem;
    }
  }
  textarea {
    min-height: 8rem;
    resize: vertical;
  }
  textarea::placeholder {
    color: var(--muted-foreground);
    opacity: 1;
  }
  [aria-invalid='true'] {
    border-color: var(--error);
  }
  [data-field-error] {
    font-size: 0.9rem;
    color: var(--error);
  }
</style>
