---
import { ArrowUpRight } from '@lucide/astro';
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;
const { class: className, ...attributes } = Astro.props;
---

<a class:list={['text-link', className]} {...attributes}>
  <slot /> <ArrowUpRight aria-hidden="true" data-card-arrow />
</a>

<style>
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-inline);
    min-height: 44px;
    font-size: var(--type-control);
    font-weight: var(--weight-medium);
  }
  .text-link :global(svg) {
    width: var(--icon-chevron);
    height: var(--icon-chevron);
    flex: none;
  }
  .text-link:is(:focus-visible, :active) {
    text-decoration-thickness: 0.14em;
  }
  @media (prefers-reduced-motion: no-preference) {
    .text-link:focus-visible :global(svg) {
      --surface-motion: 1;
    }
    .text-link:active :global(svg) {
      --surface-motion: 1;
      --arrow-x: var(--motion-arrow-pressed-x);
      --arrow-y: var(--motion-arrow-pressed-y);
    }
    @media (hover: hover) and (pointer: fine) {
      .text-link:hover:not(:active) :global(svg) {
        --surface-motion: 1;
      }
    }
  }
</style>
