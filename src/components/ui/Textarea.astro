---
import type { HTMLAttributes } from 'astro/types';
import {
  textareaAppearances,
  fieldDensities,
  type TextareaAppearance,
  type FieldDensity,
} from './field';

interface Props extends HTMLAttributes<'textarea'> {
  appearance?: TextareaAppearance;
  density?: FieldDensity;
}
const {
  appearance = textareaAppearances[0],
  density = fieldDensities[0],
  class: className,
  ...rest
} = Astro.props;
---

<textarea
  {...rest}
  data-field={appearance}
  class:list={[
    'ds-textarea',
    density === 'compact' ? 'ds-textarea-sm' : 'ds-textarea-md',
    className,
  ]}
><slot /></textarea>
