---
import type { HTMLAttributes } from 'astro/types';
import { cardOptions } from './card';

type Props = HTMLAttributes<'div'> & {
  as?: 'div' | 'article' | 'section' | 'li';
} & {
  [Option in keyof typeof cardOptions]?: (typeof cardOptions)[Option][number];
};

const {
  as: Tag = 'div',
  surface = cardOptions.surface[0],
  density = cardOptions.density[0],
  edge = cardOptions.edge[0],
  interaction = cardOptions.interaction[0],
  class: className,
  ...rest
} = Astro.props;
---

<Tag
  data-card-outline={edge === 'outline' || undefined}
  data-card-interactive={interaction !== 'static' || undefined}
  data-card-hit-area={interaction === 'single-link' || undefined}
  {...rest}
  data-slot="card"
  data-surface={surface}
  data-density={density}
  class:list={[
    'ds-card ui-card',
    edge === 'border' && 'ds-card-border',
    className,
  ]}
>
  <slot />
</Tag>

<style>
  @layer theme, base, components, utilities;
  @layer utilities {
    .ui-card {
      min-inline-size: 0;
    }
    .ui-card[data-surface='elevated'] {
      background: var(--surface-elevated);
      color: var(--foreground);
    }
    .ui-card[data-surface='editorial'] {
      background: var(--editorial-surface);
      border-radius: var(--editorial-radius);
      color: var(--foreground);
    }
    .ui-card.ds-card-border {
      border-color: var(--card-edge, var(--line));
    }
    .ui-card[data-density='md'] {
      padding: var(--card-padding-md);
    }
    .ui-card[data-density='sm'] {
      padding: var(--card-padding-sm);
    }
  }
</style>
