---
import type { HTMLAttributes } from 'astro/types';
import type { accordionIndicators } from './options';

interface Props extends HTMLAttributes<'details'> {
  label: string;
  indicator?: (typeof accordionIndicators)[number];
}
const { label, indicator = 'arrow', class: className, ...rest } = Astro.props;
---

<details
  {...rest}
  class:list={[
    'ds-collapse ui-accordion',
    indicator === 'plus' ? 'ds-collapse-plus' : 'ds-collapse-arrow',
    className,
  ]}
>
  <summary class="ds-collapse-title">{label}</summary>
  <div class="ds-collapse-content">
    <slot />
  </div>
</details>

<style>
  .ui-accordion {
    border: var(--stroke-default) solid var(--line);
    border-radius: var(--radius-box);
    background: var(--surface-elevated);
  }
  summary:focus-visible {
    outline-offset: -4px;
  }
</style>
