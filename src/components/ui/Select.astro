---
import type { HTMLAttributes } from 'astro/types';
import {
  fieldAppearances,
  fieldDensities,
  type FieldAppearance,
  type FieldDensity,
} from './field';

interface Props extends HTMLAttributes<'select'> {
  appearance?: FieldAppearance;
  density?: FieldDensity;
}
const {
  appearance = fieldAppearances[0],
  density = fieldDensities[0],
  class: className,
  ...rest
} = Astro.props;
---

<select
  {...rest}
  data-field={appearance}
  class:list={[
    'ds-select',
    density === 'compact' ? 'ds-select-sm' : 'ds-select-md',
    className,
  ]}
>
  <slot />
</select>
