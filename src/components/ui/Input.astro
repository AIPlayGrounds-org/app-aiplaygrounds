---
import type { HTMLAttributes } from 'astro/types';
import {
  fieldAppearances,
  fieldDensities,
  type FieldAppearance,
  type FieldDensity,
} from './field';

interface Props extends HTMLAttributes<'input'> {
  appearance?: FieldAppearance;
  density?: FieldDensity;
}
const {
  appearance = fieldAppearances[0],
  density = fieldDensities[0],
  class: className,
  ...rest
} = Astro.props;
---

<input
  {...rest}
  data-field={appearance}
  class:list={[
    'ds-input',
    density === 'compact' ? 'ds-input-sm' : 'ds-input-md',
    className,
  ]}
/>
