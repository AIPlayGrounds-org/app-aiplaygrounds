---
import type { HTMLAttributes } from 'astro/types';
import type { alertTones, alertAppearances } from './options';

const tones = {
  info: 'ds-alert-info',
  success: 'ds-alert-success',
  warning: 'ds-alert-warning',
  error: 'ds-alert-error',
};
interface Props extends HTMLAttributes<'div'> {
  tone?: (typeof alertTones)[number];
  appearance?: (typeof alertAppearances)[number];
}
const {
  tone = 'info',
  appearance = 'soft',
  class: className,
  ...rest
} = Astro.props;
---

<div
  {...rest}
  class:list={[
    'ds-alert',
    tones[tone],
    appearance === 'outline' && 'ds-alert-outline',
    appearance === 'soft' && 'ds-alert-soft',
    className,
  ]}
>
  <slot name="icon" />
  <slot />
</div>
