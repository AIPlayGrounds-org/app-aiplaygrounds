---
import type { HTMLAttributes } from 'astro/types';
import type { controlSizes } from './options';

interface Props extends Omit<HTMLAttributes<'input'>, 'type' | 'size'> {
  name: string;
  size?: (typeof controlSizes)[number];
  native?: boolean;
}
const sizes = { sm: 'ds-radio-sm', md: 'ds-radio-md', lg: 'ds-radio-lg' };
const { size = 'md', native, class: className, ...rest } = Astro.props;
---

<input
  {...rest}
  type="radio"
  class:list={[
    !native && ['ds-radio ds-radio-primary', sizes[size]],
    className,
  ]}
/>
