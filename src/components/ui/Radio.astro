---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'input'>, 'type' | 'size'> {
  name: string;
  size?: 'sm' | 'md' | 'lg';
  native?: boolean;
}
const sizes = { sm: 'ds-radio-sm', md: 'ds-radio-md', lg: 'ds-radio-lg' };
const { size = 'md', native, class: className, ...rest } = Astro.props;
---

<input
  {...rest}
  type="radio"
  data-native-choice={native || undefined}
  class:list={['ds-radio ds-radio-primary', sizes[size], className]}
/>
