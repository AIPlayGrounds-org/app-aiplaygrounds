---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  bodyClass?: string;
  editorial?: boolean;
}

const { title, description, bodyClass, editorial } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class={bodyClass} data-editorial={editorial || undefined}>
    <a class="skip-link" href="#contenido">
      Ir al contenido
    </a>
    <slot />
  </body>
</html>
