---
import CompactHero from '../components/site/CompactHero.astro';
import { getProducts } from '../data/directories';
import InteriorLayout from '../layouts/InteriorLayout.astro';
import DirectoryLink from '../components/site/DirectoryLink.astro';
import '../styles/directories.css';

const entries = await getProducts();
---

<InteriorLayout
  title="AI Labs: directorio de productos | AI PlayGrounds"
  description="Conoce AI Labs, donde AI PlayGrounds experimenta con nuevas tecnologías y desarrolla iniciativas y productos con inteligencia artificial."
>
  <CompactHero
    id="B1"
    variant="construction"
    title="Transformamos ideas en soluciones con IA."
    description="Explora las iniciativas y productos que estamos desarrollando para experimentar con nuevas tecnologías y responder a problemas reales."
  />
  <div class="site-container directory">
    <section id="B3">
      <h2 class="directory-section-title">Directorio de productos</h2>
      {entries.length === 0 ? (
        <p class="directory-empty">Aún no hay productos publicados.</p>
      ) : (
        <ul class="product-grid" role="list">
          {entries.map((product) => (
            <li class="product-card" data-card-interactive data-card-hit-area>
              <h3>{product.name}</h3>
              <p>{product.utility}</p>
              <dl class="product-meta">
                <div>
                  <dt>Público</dt>
                  <dd>{product.audience}</dd>
                </div>
                <div>
                  <dt>Estado</dt>
                  <dd>{product.status}</dd>
                </div>
              </dl>
              <div class="product-actions">
                <DirectoryLink
                  href={`/ai-labs/${product.slug}/`}
                  title={product.name}
                />
                {product.demo && (
                  <span class="directory-demo">Demostración</span>
                )}
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</InteriorLayout>

<style>
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 28rem), 1fr));
    gap: 1rem;
  }
  .product-card {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    padding: clamp(1rem, 3vw, 2rem);
    background: var(--home-surface);
    border: 1px solid var(--card-edge);
    border-radius: 0.4rem;
  }
  .product-card h3 {
    font-size: clamp(1.35rem, 1.18rem + 0.6vw, 1.75rem);
    text-wrap: pretty;
  }
  .product-card p {
    color: var(--secondary-text);
    max-inline-size: 55ch;
    margin-block-end: 1rem;
  }
  .product-meta {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 0.75rem;
    margin-block-start: auto;
    padding-block-start: 0.9rem;
    border-block-start: 1px solid var(--border);
  }
  .product-meta dt {
    margin-block-end: 0.2rem;
    color: var(--secondary-text);
    font-size: 0.875rem;
  }
  .product-meta dd {
    font-weight: 500;
  }
  .product-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }
</style>
