---
import CompactHero from '../components/site/CompactHero.astro';
import ProductCard from '../components/labs/ProductCard.astro';
import DirectoryCatalog from '../components/directory/DirectoryCatalog.astro';
import DirectoryResult from '../components/directory/DirectoryResult.astro';
import { getProducts } from '../data/labs';
import {
  buildFacets,
  directoryLimits,
  indexProduct,
  sortProducts,
} from '../data/labs-directory';
import InteriorLayout from '../layouts/InteriorLayout.astro';

const entries = (await getProducts()).map((product) => ({
  product,
  index: indexProduct(product),
}));
entries.sort((a, b) => sortProducts(a.index, b.index, 'recent'));
const groups = buildFacets(entries.map(({ index }) => index));
---

<InteriorLayout
  title="AI Labs: directorio de productos | AI PlayGrounds"
  description="Conoce AI Labs, donde AI PlayGrounds experimenta con nuevas tecnologías y desarrolla iniciativas y productos con inteligencia artificial."
>
  <CompactHero
    id="B1"
    variant="construction"
    title="Transformamos ideas en soluciones con IA."
    description="Explora las iniciativas y productos que estamos desarrollando para experimentar con nuevas tecnologías y responder a problemas reales."
  />
  <DirectoryCatalog
    directory="labs"
    sectionId="B3"
    title="Directorio de productos"
    singular="producto"
    plural="productos"
    emptyMessage="Aún no hay productos publicados."
    placeholder="Buscar productos, categorías, tecnologías…"
    total={entries.length}
    primary={groups.slice(0, directoryLimits.primaryGroups)}
    secondary={groups.slice(directoryLimits.primaryGroups)}
    defaultView="grid"
  >
    {entries.map(({ product, index }, position) => (
      <DirectoryResult {index}>
        <ProductCard {product} eager={position === 0} />
      </DirectoryResult>
    ))}
  </DirectoryCatalog>
</InteriorLayout>
