---
import { products } from '../data/directories';
import InteriorLayout from '../layouts/InteriorLayout.astro';
import ClosingCTA from '../components/site/ClosingCTA.astro';
import DirectoryCard from '../components/site/DirectoryCard.astro';

const entries = import.meta.env.DEV
  ? [...products, ...(await import('../data/directories.demo')).demoProducts]
  : products;
---

<InteriorLayout
  title="AI Labs: directorio de productos | AI PlayGrounds"
  description="Conoce AI Labs, el directorio de productos de AI PlayGrounds, y el contexto de sus iniciativas y productos relacionados con inteligencia artificial."
>
  <section id="B1" class="page-hero labs-hero">
    <div class="site-container">
      <h1>AI Labs: directorio de productos</h1>
      <div class="lead">
        <p>
          AI Labs es el directorio de productos de AI PlayGrounds. Da
          visibilidad a productos e iniciativas relacionados con inteligencia
          artificial y aporta contexto sobre su procedencia y estado.
        </p>
        <p>
          El contexto importa: qué necesidad aborda la iniciativa, quiénes la
          impulsan y en qué etapa se encuentra.
        </p>
      </div>
      <a class="interior-link" href="#B3">
        Ver productos ↓
      </a>
    </div>
  </section>
  <section id="B3" class="interior-section">
    <div class="site-container">
      <h2>Directorio de productos</h2>
      {entries.length === 0 ? (
        <p class="directory-empty">Aún no hay productos en el directorio.</p>
      ) : (
        <div class="interior-grid">
          {entries.map((product) => (
            <DirectoryCard
              title={product.name}
              description={product.utility}
              details={[
                product.audience,
                [product.creator, product.status].filter(Boolean).join(' · '),
              ]}
              demo={'demo' in product}
              source={product.source}
            />
          ))}
        </div>
      )}
    </div>
  </section>
  <ClosingCTA
    id="B5"
    title="Conecta con la comunidad"
    paragraphs={[
      'La comunidad de AI PlayGrounds está abierta. Puedes acercarte a su historia de encuentros y al grupo de WhatsApp para compartir conocimiento sobre IA.',
    ]}
    buttons={[
      { label: 'Ir a la comunidad', href: '/comunidad/', variant: 'primary' },
    ]}
  />
</InteriorLayout>

<style>
  .labs-hero {
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }
</style>
