---
import CompactHero from '../components/site/CompactHero.astro';
import InteriorLayout from '../layouts/InteriorLayout.astro';
import ClosingCTA from '../components/site/ClosingCTA.astro';
import CommunityCalendar from '../components/site/CommunityCalendar.astro';
import EditorialMotion from '../components/site/EditorialMotion.astro';

const invitation = import.meta.env.PUBLIC_COMMUNITY_WHATSAPP_URL;
const whatsapp =
  typeof invitation === 'string' &&
  /^https:\/\/chat\.whatsapp\.com\/[A-Za-z0-9_-]+\/?$/.test(invitation)
    ? invitation
    : undefined;
---

<InteriorLayout
  title="Comunidad de inteligencia artificial | AI PlayGrounds"
  description="Conoce la comunidad de AI PlayGrounds, sus encuentros y talleres sobre inteligencia artificial y cómo participar."
>
  <CompactHero
    id="C1"
    variant="connection"
    title="Conecta con personas que comparten tu interés por la IA."
    description="Un espacio abierto para compartir experiencias, aprender de otras personas y participar en encuentros alrededor de la inteligencia artificial."
  />
  <CommunityCalendar />
  <ClosingCTA
    id="C6"
    title="Súmate al grupo de WhatsApp"
    paragraphs={[
      'El grupo es la vía de acceso a la comunidad general. Las actividades tienen sus propias condiciones, que se consultan junto a cada convocatoria.',
      whatsapp
        ? 'Participar en la comunidad o en un encuentro es distinto de formar parte del equipo organizador.'
        : 'La invitación al grupo de WhatsApp aún no está disponible.',
    ]}
    buttons={
      whatsapp
        ? [
            {
              label: 'Unirme a la comunidad',
              href: whatsapp,
              variant: 'primary',
            },
          ]
        : []
    }
  />
  <EditorialMotion />
</InteriorLayout>
