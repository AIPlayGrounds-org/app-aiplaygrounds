---
import { Image } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import { inicioImages } from '../assets/inicio';
import Button from '../components/starwind/button/Button.astro';
import Card from '../components/starwind/card/Card.astro';
import ClosingCTA from '../components/site/ClosingCTA.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const fields = [
  {
    title: 'AI Foundations',
    image: inicioImages.foundations,
    text: 'Cómo funcionan los modelos y métodos de inteligencia artificial, cómo evaluarlos y cómo mejorarlos. AI Foundations se ocupa de los fundamentos técnicos de la IA.',
  },
  {
    title: 'AI for Software',
    image: inicioImages.software,
    text: 'IA aplicada al diseño, la construcción, las pruebas y la mejora del software. El proceso de desarrollo y el criterio para trabajar con IA están en el centro.',
  },
  {
    title: 'AI for Science',
    image: inicioImages.science,
    text: 'Inteligencia artificial aplicada a preguntas y procesos científicos, con atención a los datos, el método y la validación de los resultados.',
  },
  {
    title: 'AI for Finance',
    image: inicioImages.finance,
    text: 'Aplicaciones de inteligencia artificial a problemas y procesos financieros: su utilidad, sus riesgos y las decisiones que requieren criterio humano.',
  },
];
---

<BaseLayout
  title="AI PlayGrounds | Inteligencia artificial en comunidad"
  description="AI PlayGrounds es una organización enfocada en inteligencia artificial e impulsada por su comunidad. Conoce sus verticales de trabajo, actividades e iniciativas."
  bodyClass="home"
>
  <SiteHeader />
  <main id="contenido" tabindex="-1">
    <section id="I1" class="hero">
      <Image
        src={inicioImages.hero}
        alt=""
        format="webp"
        widths={[480, 768, 1024, 1440]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="hero-image"
      />
      <div class="site-container hero-content">
        <h1>Aprendemos, investigamos, experimentamos y construimos con IA.</h1>
        <p>
          AI PlayGrounds es una organización enfocada en inteligencia
          artificial, impulsada por su comunidad.
        </p>
        <div class="actions">
          <Button href="/comunidad/" variant="primary">
            Ir a la comunidad
          </Button>
          <Button href="/ai-labs/" variant="outline">
            Explorar AI Labs
          </Button>
        </div>
      </div>
    </section>

    <section id="I2" class="site-container section-space community">
      <h2>El conocimiento crece cuando se comparte</h2>
      <div class="community-copy">
        <p>
          La comunidad comparte conocimiento, hace preguntas y participa en las
          actividades que impulsan nuestro trabajo. El equipo sostiene la
          organización y sus cuatro verticales de trabajo.
        </p>
        <div class="links">
          <a class="text-link" href="/comunidad/#C3">
            Actividades de la comunidad <ArrowUpRight aria-hidden="true" />
          </a>
          <a class="text-link" href="/equipo/">
            Nuestro equipo <ArrowUpRight aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <section id="I3" class="site-container section-space">
      <h2>Cuatro verticales, preguntas diferentes</h2>
      <p class="section-intro">
        Nuestras verticales de trabajo van de los modelos y sus métodos a las
        aplicaciones en software, ciencia y finanzas.
      </p>
      <div class="fields">
        {fields.map((field) => (
          <article>
            <Card class="field-card gap-0 p-0">
              <div class="field-copy">
                <h3>{field.title}</h3>
                <p>{field.text}</p>
              </div>
              <Image
                src={field.image}
                alt=""
                format="webp"
                width={960}
                widths={[320, 480, 640, 800, 960]}
                sizes="(min-width: 80rem) 308px, (min-width: 60rem) calc((92vw - 3rem) / 4), (min-width: 40rem) calc((92vw - 1rem) / 2), calc(100vw - 2rem)"
                loading="lazy"
              />
            </Card>
          </article>
        ))}
      </div>
    </section>

    <section id="I4" class="site-container section-space history">
      <div class="history-heading">
        <h2>De los encuentros a la práctica</h2>
        <p>
          Desde 2025 hemos organizado más de 30 eventos de comunidad. Esa
          trayectoria incluye workshops de desarrollo asistido por IA, un
          bootcamp y la coorganización de encuentros y hackathons.
        </p>
      </div>
      <div class="history-grid">
        <div class="stat">
          <p class="eyebrow">Eventos organizados desde 2025</p>
          <strong>+30</strong>
          <p>eventos de comunidad</p>
        </div>
        <div class="events">
          <article class="event featured">
            <p class="eyebrow">Coorganizado</p>
            <h3>hack@latam</h3>
            <p class="metrics">
              <span>
                <b>1,200+</b> postulantes
              </span>{' '}
              <span>
                <b>56</b> equipos
              </span>{' '}
              <span>
                <b>36 h</b>
              </span>
            </p>
            <p class="event-note">From Hack to Pilot: Perú Demo Day</p>
            <p class="tags">
              <span>UTEC</span>
            </p>
          </article>
          <article class="event">
            <p class="eyebrow">Coorganizado</p>
            <h3>IA Hackathon</h3>
            <p class="metrics">
              <span>
                <b>800+</b> postulantes
              </span>{' '}
              <span>
                <b>22</b> equipos y proyectos
              </span>
            </p>
            <p class="tags">
              <span>The Hackathon Company</span> <span>Crafter Station</span>{' '}
              <span>kebo</span>
            </p>
          </article>
          <article class="event">
            <p class="eyebrow">Coorganizado</p>
            <h3>The Real AI</h3>
            <p class="metrics">
              <span>
                <b>+150</b> participantes
              </span>{' '}
              <span>
                <b>7</b> speakers
              </span>
            </p>
            <p class="tags">
              <span>looper.ai</span> <span>UTEC</span>
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="I5" class="site-container section-space">
      <h2>Ideas, aprendizaje y nuevas conversaciones</h2>
      <div class="pathways">
        <article class="path-card path-labs">
          <div class="path-illustration" aria-hidden="true">
            <svg viewBox="0 0 310 140" fill="none">
              <path d="M16 102C70 33 114 31 155 72s75 67 142 10M18 118C75 68 118 58 155 82s82 51 132 15M23 128c64-34 101-37 132-35s77 35 119 16M57 58c38-45 82-38 110-13s64 70 112 22M88 27c27-23 62-16 88 8s59 60 84 20" />
              <path class="path-guide" d="M28 108 84 65 148 73 206 50 273 74" />
              <circle cx="28" cy="108" r="4" />
              <circle cx="84" cy="65" r="4" />
              <circle cx="148" cy="73" r="4" />
              <circle cx="206" cy="50" r="4" />
              <circle cx="273" cy="74" r="4" />
            </svg>
          </div>
          <h3>AI Labs · experimentación e iniciativas tempranas</h3>
          <p>
            Conoce nuestros experimentos y prototipos, quiénes los impulsan y en
            qué etapa están.
          </p>
          <a class="text-link" href="/ai-labs/">
            Explorar AI Labs <ArrowUpRight aria-hidden="true" />
          </a>
        </article>
        <article class="path-card path-academy">
          <div class="path-illustration" aria-hidden="true">
            <svg viewBox="0 0 310 140" fill="none">
              <path d="M155 119V41M155 48C127 22 86 18 47 26v71c38-5 72-4 108 22 36-26 70-27 108-22V26c-39-8-80-4-108 22ZM47 40l-15 5v71c44-9 84-5 123 10 39-15 79-19 123-10V45l-15-5" />
              <path
                class="path-guide"
                d="M64 49c29-5 53 1 74 13M64 65c28-4 52 2 74 13M64 81c23-3 44 1 62 9M172 63c21-12 45-18 74-13M172 79c22-11 46-17 74-13M184 91c18-8 39-12 62-9"
              />
            </svg>
          </div>
          <h3>AI Academy · aprendizaje con dos enfoques</h3>
          <p>
            Amplía lo que puedes construir: usa IA para desarrollar software
            (Software with AI) o incorpórala en tus aplicaciones y comprueba
            cómo funciona (AI Engineering).
          </p>
          <a class="text-link" href="/formacion/">
            Ver las líneas de AI Academy <ArrowUpRight aria-hidden="true" />
          </a>
        </article>
        <article class="path-card path-organizations">
          <div class="path-illustration" aria-hidden="true">
            <svg viewBox="0 0 310 140" fill="none">
              <path d="M27 103h256M42 103V89h53v14m120 0V89h53v14M74 89c15-48 48-72 81-72s66 24 81 72M95 89c14-34 35-52 60-52s46 18 60 52M112 62v41m43-66v66m43-41v41M54 118h202" />
              <path class="path-guide" d="M45 72h220" />
              <circle cx="74" cy="89" r="4" />
              <circle cx="155" cy="37" r="4" />
              <circle cx="236" cy="89" r="4" />
            </svg>
          </div>
          <h3>Para organizaciones</h3>
          <p>
            Alianzas institucionales, oportunidades comerciales y formación
            personalizada para equipos. Una conversación permite situar cada
            posibilidad en el contexto de tu organización.
          </p>
          <a class="text-link" href="/empresas/">
            AI PlayGrounds para organizaciones{' '}
            <ArrowUpRight aria-hidden="true" />
          </a>
        </article>
      </div>
    </section>

    <ClosingCTA
      id="I8"
      title="La próxima conversación puede empezar contigo"
      paragraphs={[
        'Si la IA también te mueve a aprender y compartir, nuestra comunidad está abierta. Acércate a sus actividades y al grupo de WhatsApp.',
        '¿Vienes desde una empresa o institución? Cuéntanos qué te gustaría trabajar en conjunto o qué necesita tu equipo.',
      ]}
      buttons={[
        { label: 'Ir a la comunidad', href: '/comunidad/', variant: 'primary' },
        {
          label: 'AI PlayGrounds para mi organización',
          href: '/empresas/',
          variant: 'outline',
        },
      ]}
    />
  </main>
  <SiteFooter />
</BaseLayout>

<script>
  const motion = matchMedia('(prefers-reduced-motion: no-preference)');

  if ('IntersectionObserver' in window && motion.matches) {
    const targets = document.querySelectorAll<HTMLElement>(
      '#I2 h2, #I2 .community-copy, #I3 h2, #I3 .section-intro, #I3 article, #I4 .history-heading, #I4 .stat, #I4 .event, #I5 h2, #I5 .path-card, #I8 .closing, body.home .footer-inner, body.home .landscape-frame',
    );
    let remaining = targets.length;
    const observer = new IntersectionObserver(
      (entries) => {
        for (const { target, isIntersecting } of entries) {
          if (!isIntersecting) continue;
          observer.unobserve(target);
          remaining -= 1;
          if (motion.matches && !target.matches(':focus-within')) {
            target.setAttribute('data-home-entering', '');
          }
        }
        if (remaining === 0) observer.disconnect();
      },
      { rootMargin: '0px 0px -112px' },
    );
    targets.forEach((target) => {
      observer.observe(target);
      const finish = (event: AnimationEvent) => {
        if (
          event.target === target &&
          event.animationName.startsWith('home-reveal')
        ) {
          target.removeAttribute('data-home-entering');
        }
      };
      target.addEventListener('animationend', finish);
      target.addEventListener('animationcancel', finish);
      target.addEventListener('focusin', () =>
        target.removeAttribute('data-home-entering'),
      );
    });
    motion.addEventListener('change', () => {
      if (motion.matches) return;
      observer.disconnect();
      targets.forEach((target) => target.removeAttribute('data-home-entering'));
    });
  }
</script>

<style>
  :global(body.home) {
    --home-background: #fbf6ec;
    --home-surface: #fbf3e6;
    --home-card: #fff9f0;
    --home-ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --home-entrance-ease: cubic-bezier(0.23, 0.65, 0.25, 1);
    --home-response: 140ms;
    background: var(--home-background);
  }
  :global(body.home :is(a, summary):focus) {
    outline: 3px solid var(--focus-ring);
    outline-offset: 4px;
  }
  @media (forced-colors: active) {
    :global(body.home :is(a, summary):focus) {
      outline-color: Highlight;
    }
  }
  .hero {
    min-height: 48rem;
    position: relative;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .hero-content {
    position: relative;
    text-align: center;
    padding-block: 8rem 6rem;
  }
  .hero h1 {
    max-width: 34ch;
    margin-inline: auto;
    font-size: clamp(2.25rem, 1.5rem + 2.5vw, 3.5rem);
  }
  .hero p {
    max-width: 38rem;
    font-size: clamp(1.15rem, 1rem + 0.45vw, 1.4rem);
    margin: 1.5rem auto 0;
  }
  .actions,
  .links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }
  .hero .actions {
    justify-content: center;
    margin-top: 1.5rem;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 500;
  }
  .text-link :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: none;
  }
  h2 {
    font-size: clamp(2rem, 1.5rem + 1.5vw, 3rem);
  }
  h3 {
    font-size: 1.25rem;
  }
  .community,
  .history-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .community h2,
  .history-heading h2 {
    max-width: 18ch;
  }
  .community-copy {
    border-left: 1px solid var(--border);
    padding-left: clamp(2rem, 4vw, 3rem);
  }
  .community-copy p,
  .history-heading p {
    max-width: 60ch;
    color: var(--secondary-text);
  }
  .section-intro {
    max-width: 70ch;
    margin-top: 0.75rem;
    color: var(--secondary-text);
  }
  .fields {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }
  .fields article {
    min-width: 0;
  }
  .fields :global(.field-card) {
    overflow: hidden;
    height: 100%;
    border-radius: 0.4rem;
    background: var(--home-surface);
  }
  .field-copy {
    padding: 1.5rem 1.25rem 1rem;
    flex: 1;
  }
  .field-copy p {
    margin-top: 0.75rem;
    color: var(--secondary-text);
  }
  .fields img {
    display: block;
    width: 100%;
    height: auto;
    margin-top: auto;
  }
  .history-grid {
    display: grid;
    grid-template-columns: 1fr 2.5fr;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  .stat {
    padding: 1rem 2rem;
    border-right: 1px solid var(--border);
  }
  .stat strong {
    display: block;
    font: 600 clamp(5rem, 8vw, 8rem)/1 var(--font-heading);
    letter-spacing: -0.06em;
    margin-block: 1rem;
  }
  .eyebrow {
    font-size: 0.7rem;
    text-transform: uppercase;
    color: var(--secondary-text);
  }
  .events {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .event {
    padding: 1rem 2rem;
  }
  .event.featured {
    grid-column: 1 / -1;
    border-bottom: 1px solid var(--border);
  }
  .event:last-child {
    border-left: 1px solid var(--border);
  }
  .event h3 {
    margin-top: 0.6rem;
  }
  .metrics {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    font-size: 0.875rem;
    margin-top: 0.4rem;
  }
  .metrics b {
    font: 600 1.35rem var(--font-heading);
  }
  .event-note {
    font-size: 0.875rem;
    color: var(--secondary-text);
    margin-top: 0.5rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }
  .tags span {
    border: 1px solid var(--border);
    border-radius: 0.2rem;
    padding: 0.15rem 0.4rem;
    font-size: 0.7rem;
    color: var(--secondary-text);
  }
  .pathways {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-top: 2rem;
  }
  .path-card {
    --path-inset: clamp(1.125rem, 2vw, 1.625rem);
    --path-wash: #dce5d1;
    --path-ink: #49684c;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    min-inline-size: 0;
    border: 1px solid var(--border);
    border-radius: 0.4rem;
    background: var(--home-card);
  }
  .path-academy {
    --path-wash: #eae0c8;
    --path-ink: #685936;
  }
  .path-organizations {
    --path-wash: #e3e2ee;
    --path-ink: #54536d;
  }
  .path-illustration {
    display: grid;
    place-items: center;
    block-size: clamp(8rem, 13vw, 11rem);
    border-radius: 0.35rem 0.35rem 0 0;
    border-block-end: 1px solid var(--border);
    background: var(--path-wash);
    color: var(--path-ink);
  }
  .path-illustration svg {
    inline-size: min(80%, 17rem);
    block-size: 86%;
    stroke: currentColor;
    stroke-width: 1.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .path-guide {
    stroke-dasharray: 3 4;
  }
  .path-illustration circle {
    fill: var(--path-wash);
    stroke-width: 1.55;
  }
  .path-card > :is(h3, p, a) {
    margin-inline: var(--path-inset);
  }
  .path-card h3 {
    margin-block-start: var(--path-inset);
    text-wrap: pretty;
  }
  .path-card p {
    margin-block-start: 0.55rem;
    color: var(--secondary-text);
  }
  .path-card .text-link {
    justify-self: start;
    margin-block: 0.65rem 0.75rem;
  }
  .text-link:is(:focus-visible, :active) {
    text-decoration-thickness: 0.14em;
  }
  :global(body.home a[data-slot='button']:active) {
    background-color: color-mix(in srgb, currentColor 18%, var(--primary));
  }
  :global(body.home a[data-slot='button'].border:active) {
    background-color: color-mix(
      in srgb,
      var(--foreground) 13%,
      var(--background)
    );
  }
  :global(
    body.home
      :is(.desktop-nav, .mobile-nav, .footer)
      a:not([data-slot='button']):active
  ) {
    text-decoration-line: underline;
    text-decoration-thickness: 0.14em;
  }
  .path-card:focus-within .path-guide {
    stroke-width: 1.85;
  }
  @media (hover: hover) and (pointer: fine) {
    .path-card:has(.text-link:hover) .path-guide {
      stroke-width: 1.85;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-content > :is(h1, p, .actions) {
      animation: home-hero-arrive 720ms var(--home-entrance-ease)
        var(--home-hero-delay, 0ms) backwards;
    }
    .hero-content > p {
      --home-hero-delay: 170ms;
    }
    .hero-content > .actions {
      --home-hero-delay: 320ms;
    }
    .hero-content > .actions:focus-within {
      animation: none;
    }
    /* Only the observer adds this attribute. Offscreen content is never hidden. */
    :global(body.home [data-home-entering]:not(:focus-within)) {
      animation: var(--home-entry, home-reveal-rise) 760ms
        var(--home-entrance-ease) var(--home-entry-delay, 0ms) backwards;
    }
    .community-copy,
    .section-intro {
      --home-entry-delay: 95ms;
    }
    .history .stat,
    :global(body.home .landscape-frame) {
      --home-entry: home-reveal-ink;
    }
    .fields article,
    .path-card,
    :global(body.home #I8 .closing) {
      --home-entry: home-reveal-card;
    }
    @media (min-width: 52rem) {
      :is(.fields, .pathways) > article:nth-child(2n),
      .event:not(.featured) {
        --home-entry-delay: 110ms;
      }
      :is(.fields, .pathways) > article:nth-child(3) {
        --home-entry-delay: 195ms;
      }
    }
    @media (min-width: 60rem) {
      .fields > article:nth-child(4) {
        --home-entry-delay: 280ms;
      }
    }
    .text-link :global(svg) {
      transition: translate var(--home-response) ease-out;
    }
    .text-link:focus-visible :global(svg) {
      translate: 4px -3px;
      transition-timing-function: var(--home-ease-out);
    }
    .text-link:active :global(svg) {
      translate: 1px -1px;
    }
    .fields img,
    .path-illustration svg,
    :global(body.home #I8 .closing-image) {
      transition:
        scale 180ms ease-out,
        translate 180ms ease-out;
    }
    .fields img {
      transform-origin: top center;
    }
    :global(body.home #I8 .closing-image) {
      transform-origin: top left;
    }
    .path-card:focus-within .path-illustration svg {
      translate: 0 -6px;
      transition: translate 240ms var(--home-ease-out);
    }
    :global(body.home #I8 .closing:focus-within .closing-image) {
      scale: 1.04;
      transition: scale 260ms var(--home-ease-out);
    }
    :global(body.home .mobile-nav .menu-icon) {
      transition: transform var(--home-response) var(--home-ease-out);
    }
    @media (hover: hover) and (pointer: fine) {
      .text-link:hover:not(:active) :global(svg) {
        translate: 4px -3px;
        transition-timing-function: var(--home-ease-out);
      }
      .fields article:hover img,
      :global(body.home #I8 .closing:has(a:hover) .closing-image) {
        scale: 1.04;
        transition: scale 260ms var(--home-ease-out);
      }
      .path-card:has(.text-link:hover) .path-illustration svg {
        translate: 0 -6px;
        transition: translate 240ms var(--home-ease-out);
      }
    }
  }
  @keyframes home-hero-arrive {
    from {
      opacity: 0;
