---
import { Image } from 'astro:assets';
import ImmersiveHero from '../components/site/ImmersiveHero.astro';
import Section from '../components/site/Section.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import TextLink from '../components/site/TextLink.astro';
import InitiativeCard from '../components/site/InitiativeCard.astro';
import InitiativeGrid from '../components/site/InitiativeGrid.astro';
import EditorialMotion from '../components/site/EditorialMotion.astro';
import { inicioImages } from '../assets/inicio';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import ClosingCTA from '../components/site/ClosingCTA.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const fields = [
  {
    title: 'AI Foundations',
    image: inicioImages.foundations,
    text: 'Cómo funcionan los modelos y métodos de inteligencia artificial, cómo evaluarlos y cómo mejorarlos. AI Foundations se ocupa de los fundamentos técnicos de la IA.',
  },
  {
    title: 'AI for Software',
    image: inicioImages.software,
    text: 'IA aplicada al diseño, la construcción, las pruebas y la mejora del software. El proceso de desarrollo y el criterio para trabajar con IA están en el centro.',
  },
  {
    title: 'AI for Science',
    image: inicioImages.science,
    text: 'Inteligencia artificial aplicada a preguntas y procesos científicos, con atención a los datos, el método y la validación de los resultados.',
  },
  {
    title: 'AI for Finance',
    image: inicioImages.finance,
    text: 'Aplicaciones de inteligencia artificial a problemas y procesos financieros: su utilidad, sus riesgos y las decisiones que requieren criterio humano.',
  },
];
---

<BaseLayout
  title="AI PlayGrounds | Inteligencia artificial en comunidad"
  description="AI PlayGrounds es una organización enfocada en inteligencia artificial e impulsada por su comunidad. Conoce sus verticales de trabajo, actividades e iniciativas."
  bodyClass="home"
  editorial
>
  <SiteHeader immersive />
  <main id="contenido" tabindex="-1">
    <ImmersiveHero
      id="I1"
      image={inicioImages.hero}
      imageSizes="(max-width: 40rem) 1024px, 100vw"
      title="Aprendemos, investigamos, experimentamos y construimos con IA."
      description="AI PlayGrounds es una organización enfocada en inteligencia artificial, impulsada por su comunidad."
    >
      <Button href="/comunidad/" variant="primary">
        Ir a la comunidad
      </Button>
      <Button href="/ai-labs/" variant="outline">
        Explorar AI Labs
      </Button>
    </ImmersiveHero>

    <Section id="I2" class="community">
      <SectionHeading>El conocimiento crece cuando se comparte</SectionHeading>
      <div class="community-copy" data-reveal>
        <p>
          La comunidad comparte conocimiento, hace preguntas y participa en las
          actividades que impulsan nuestro trabajo. El equipo sostiene la
          organización y sus cuatro verticales de trabajo.
        </p>
        <div class="links">
          <TextLink href="/comunidad/#C3">Actividades de la comunidad</TextLink>
          <TextLink href="/equipo/">Nuestro equipo</TextLink>
        </div>
      </div>
    </Section>

    <Section id="I3">
      <SectionHeading>Cuatro verticales, preguntas diferentes</SectionHeading>
      <p class="section-intro" data-reveal>
        Nuestras verticales de trabajo van de los modelos y sus métodos a las
        aplicaciones en software, ciencia y finanzas.
      </p>
      <div class="fields" data-reveal-group>
        {fields.map((field) => (
          <article data-reveal="card">
            <Card
              class="field-card"
              surface="elevated"
              density="none"
              edge="outline"
            >
              <div class="field-copy">
                <h3>{field.title}</h3>
                <p>{field.text}</p>
              </div>
              <Image
                src={field.image}
                alt=""
                format="webp"
                width={960}
                widths={[320, 480, 640, 800, 960]}
                sizes="(min-width: 80rem) 308px, (min-width: 60rem) calc((92vw - 3rem) / 4), (min-width: 40rem) calc((92vw - 1rem) / 2), calc(100vw - 2rem)"
                loading="lazy"
              />
            </Card>
          </article>
        ))}
      </div>
    </Section>

    <Section id="I4" class="history">
      <div class="history-heading" data-reveal>
        <SectionHeading>De los encuentros a la práctica</SectionHeading>
        <p>
          Desde 2025 hemos organizado más de 30 eventos de comunidad. Esa
          trayectoria incluye workshops de desarrollo asistido por IA, un
          bootcamp y la coorganización de encuentros y hackathons.
        </p>
      </div>
      <div class="history-grid">
        <div class="stat" data-reveal="ink">
          <p class="eyebrow">Eventos organizados desde 2025</p>
          <strong>+30</strong>
          <p>eventos de comunidad</p>
        </div>
        <div class="events">
          <article class="event featured" data-reveal>
            <p class="eyebrow">Coorganizado</p>
            <h3>hack@latam</h3>
            <p class="metrics">
              <span>
                <b>1,200+</b> postulantes
              </span>{' '}
              <span>
                <b>56</b> equipos
              </span>{' '}
              <span>
                <b>36 h</b>
              </span>
            </p>
            <p class="event-note">From Hack to Pilot: Perú Demo Day</p>
            <p class="tags">
              <span>UTEC</span>
            </p>
          </article>
          <article class="event" data-reveal>
            <p class="eyebrow">Coorganizado</p>
            <h3>IA Hackathon</h3>
            <p class="metrics">
              <span>
                <b>800+</b> postulantes
              </span>{' '}
              <span>
                <b>22</b> equipos y proyectos
              </span>
            </p>
            <p class="tags">
              <span>The Hackathon Company</span> <span>Crafter Station</span>{' '}
              <span>kebo</span>
            </p>
          </article>
          <article class="event" data-reveal>
            <p class="eyebrow">Coorganizado</p>
            <h3>The Real AI</h3>
            <p class="metrics">
              <span>
                <b>+150</b> participantes
              </span>{' '}
              <span>
                <b>7</b> speakers
              </span>
            </p>
            <p class="tags">
              <span>looper.ai</span> <span>UTEC</span>
            </p>
          </article>
        </div>
      </div>
    </Section>

    <Section id="I5">
      <SectionHeading data-reveal>
        Ideas, aprendizaje y nuevas conversaciones
      </SectionHeading>
      <InitiativeGrid>
        <InitiativeCard
          illustration="labs"
          title="AI Labs · experimentación e iniciativas tempranas"
          description="Conoce nuestros experimentos y prototipos, quiénes los impulsan y en qué etapa están."
          href="/ai-labs/"
          label="Explorar AI Labs"
        />
        <InitiativeCard
          illustration="academy"
          title="AI Academy · aprendizaje con dos enfoques"
          description="Amplía lo que puedes construir: usa IA para desarrollar software (Software with AI) o incorpórala en tus aplicaciones y comprueba cómo funciona (AI Engineering)."
          href="/formacion/"
          label="Ver las líneas de AI Academy"
        />
        <InitiativeCard
          illustration="organizations"
          title="Para organizaciones"
          description="Alianzas institucionales, oportunidades comerciales y formación personalizada para equipos. Una conversación permite situar cada posibilidad en el contexto de tu organización."
          href="/empresas/"
          label="AI PlayGrounds para organizaciones"
        />
      </InitiativeGrid>
    </Section>

    <ClosingCTA
      id="I8"
      title="La próxima conversación puede empezar contigo"
      paragraphs={[
        'Si la IA también te mueve a aprender y compartir, nuestra comunidad está abierta. Acércate a sus actividades y al grupo de WhatsApp.',
        '¿Vienes desde una empresa o institución? Cuéntanos qué te gustaría trabajar en conjunto o qué necesita tu equipo.',
      ]}
      buttons={[
        { label: 'Ir a la comunidad', href: '/comunidad/', variant: 'primary' },
        {
          label: 'AI PlayGrounds para mi organización',
          href: '/empresas/',
          variant: 'outline',
        },
      ]}
    />
  </main>
  <SiteFooter reveal />
  <EditorialMotion />
</BaseLayout>

<style>
  :global(body.home :is(a, summary):focus) {
    outline: var(--stroke-focus) solid var(--focus-ring);
    outline-offset: 4px;
  }
  @media (forced-colors: active) {
    :global(body.home :is(a, summary):focus) {
      outline-color: Highlight;
    }
  }
  .links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-control) calc(var(--space-unit) * 6);
  }
  h3 {
    font-size: var(--type-card-title);
  }
  .community,
  .history-heading {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .community > :global(h2),
  .history-heading > :global(h2) {
    max-width: 18ch;
  }
  .community-copy {
    border-left: var(--stroke-default) solid var(--line);
    padding-left: clamp(2rem, 4vw, 3rem);
  }
  .community-copy p,
  .history-heading p {
    max-width: var(--measure-intro);
    color: var(--secondary-text);
  }
  .section-intro {
    max-width: var(--measure-prose);
    margin-top: var(--space-control);
    color: var(--secondary-text);
  }
  .fields {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-stack);
    margin-top: calc(var(--space-unit) * 8);
  }
  .fields article {
    min-width: 0;
  }
  .fields :global(.field-card) {
    overflow: hidden;
    height: 100%;
    border-radius: var(--editorial-radius);
    background: var(--home-surface);
  }
  .field-copy {
    padding: calc(var(--space-unit) * 6) var(--space-card) var(--space-stack);
    flex: 1;
  }
  .field-copy p {
    margin-top: var(--space-control);
    color: var(--secondary-text);
  }
  .fields img {
    display: block;
    width: 100%;
    height: auto;
    margin-top: auto;
    border-end-start-radius: var(--radius-large);
    border-end-end-radius: var(--radius-large);
  }
  .history-grid {
    display: grid;
    grid-template-columns: 1fr 2.5fr;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }
  .stat {
    padding: var(--space-stack) calc(var(--space-unit) * 8);
    border-right: var(--stroke-default) solid var(--line);
  }
  .stat strong {
    display: block;
    font: var(--weight-heading) clamp(5rem, 8vw, 8rem)/1 var(--font-heading);
    letter-spacing: -0.06em; /* design-exception: Ajuste óptico singular de la cifra editorial de Inicio. */
    margin-block: var(--space-stack);
  }
  .eyebrow {
    font-size: var(--type-caption);
    text-transform: uppercase;
    color: var(--secondary-text);
  }
  .events {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
  .event {
    padding: var(--space-stack) calc(var(--space-unit) * 8);
  }
  .event.featured {
    grid-column: 1 / -1;
    border-bottom: var(--stroke-default) solid var(--line);
  }
  .event:last-child {
    border-left: var(--stroke-default) solid var(--line);
  }
  .event h3 {
    margin-top: var(--space-control);
  }
  .metrics {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-inline) var(--space-stack);
    font-size: var(--type-label);
    margin-top: var(--space-related);
  }
  .metrics b {
    font: var(--weight-heading) var(--type-title) var(--font-heading);
  }
  .event-note {
    font-size: var(--type-label);
    color: var(--secondary-text);
    margin-top: var(--space-related);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-inline);
    margin-top: var(--space-control);
  }
  .tags span {
    border: var(--stroke-default) solid var(--line);
    border-radius: var(--radius-small);
    padding: var(--space-micro) var(--space-related);
    font-size: var(--type-caption);
    color: var(--secondary-text);
  }
  :global(body.home a[data-slot='button']:active) {
    background-color: color-mix(in srgb, currentColor 18%, var(--primary));
  }
  :global(body.home a[data-slot='button'].border:active) {
    background-color: color-mix(
      in srgb,
      var(--foreground) 13%,
      var(--background)
    );
  }
  :global(
    body.home
      :is(.desktop-nav, .mobile-nav, .footer)
      a:not([data-slot='button']):active
  ) {
    text-decoration-line: underline;
    text-decoration-thickness: 0.14em;
  }
  @media (prefers-reduced-motion: no-preference) {
    .community-copy,
    .section-intro {
      --editorial-delay: var(--motion-delay-editorial-sibling);
    }
    @media (min-width: 52rem) {
      .event:not(.featured) {
        --editorial-delay: var(--motion-stagger-editorial);
      }
    }
    .fields img {
      transition: scale var(--duration-feedback) var(--motion-ease-standard);
      transform-origin: top center;
    }
    @media (hover: hover) and (pointer: fine) {
      .fields article:hover img {
        scale: calc(1 + var(--motion-media-zoom));
        transition: scale var(--duration-disclosure) var(--editorial-ease-out);
      }
    }
  }
  @media (min-width: 60rem) {
    main > .section-space:not(.closing-section) {
      padding-block: clamp(2.625rem, 5.25vw, 5.25rem);
    }
    main > .closing-section {
      padding-top: var(--space-control);
    }
  }
  @media (max-width: 60rem) {
    .fields {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 40rem) {
    .field-copy {
      padding-top: calc(var(--space-unit) * 8);
    }
    .community,
    .history-heading,
    .history-grid {
      grid-template-columns: 1fr;
    }
    .community-copy {
      border-left: 0;
      padding: 0;
    }
    .community,
    .history-heading {
      gap: var(--space-stack);
    }
    .fields {
      grid-template-columns: 1fr;
    }
    .history-grid {
      margin-top: calc(var(--space-unit) * 8);
    }
    .stat {
      border-right: 0;
      border-bottom: var(--stroke-default) solid var(--line);
      padding: var(--space-stack) 0 calc(var(--space-unit) * 8);
    }
    .events {
      grid-template-columns: 1fr;
    }
    .event,
    .event.featured {
      grid-column: auto;
      padding: calc(var(--space-unit) * 6) 0;
      border-bottom: var(--stroke-default) solid var(--line);
    }
    .event:last-child {
      border-left: 0;
    }
  }
</style>
