---
import CompactHero from '../components/site/CompactHero.astro';
import { getResearch } from '../data/directories';
import InteriorLayout from '../layouts/InteriorLayout.astro';
import DirectoryLink from '../components/site/DirectoryLink.astro';
import '../styles/directories.css';

const entries = await getResearch();
---

<InteriorLayout
  title="Investigación en IA y trabajos originales | AI PlayGrounds"
  description="Conoce la investigación de AI PlayGrounds y su colección de trabajos originales sobre inteligencia artificial o realizados con su apoyo."
>
  <CompactHero
    id="DI1"
    variant="exploration"
    title="Exploramos nuevas preguntas con inteligencia artificial."
    description="Desarrollamos y compartimos trabajos de investigación para comprender la IA, explorar sus aplicaciones y generar conocimiento."
  />
  <div class="site-container directory">
    <section id="DI2">
      <h2 class="directory-section-title">Directorio de investigaciones</h2>
      {entries.length === 0 ? (
        <p class="directory-empty">Aún no hay investigaciones publicadas.</p>
      ) : (
        <ul class="research-list" role="list">
          {entries.map((item) => (
            <li class="research-row" data-card-interactive data-card-hit-area>
              <div class="research-summary">
                <h3>{item.title}</h3>
                <p>{item.question}</p>
              </div>
              <div class="research-context">
                <dl class="research-meta">
                  <div>
                    <dt class="sr-only">Tipo</dt>
                    <dd>{item.type}</dd>
                  </div>
                  {item.authors && (
                    <div>
                      <dt class="sr-only">Autoría</dt>
                      <dd>{item.authors}</dd>
                    </div>
                  )}
                  {item.date && (
                    <div>
                      <dt class="sr-only">Fecha</dt>
                      <dd>{item.date}</dd>
                    </div>
                  )}
                  {item.organizationRelation && (
                    <div>
                      <dt class="sr-only">Relación con AI PlayGrounds</dt>
                      <dd>{item.organizationRelation}</dd>
                    </div>
                  )}
                  {item.peerReview && (
                    <div>
                      <dt class="sr-only">Revisión por pares</dt>
                      <dd>{item.peerReview}</dd>
                    </div>
                  )}
                </dl>
                {item.demo && <span class="directory-demo">Demostración</span>}
              </div>
              <div class="research-action">
                <DirectoryLink
                  href={`/investigacion/${item.slug}/`}
                  title={item.title}
                />
              </div>
            </li>
          ))}
        </ul>
      )}
    </section>
  </div>
</InteriorLayout>

<style>
  .research-list {
    border-block-start: 1px solid var(--outline);
  }
  .research-row {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 1.3fr) max-content;
    gap: 0.75rem clamp(1rem, 3vw, 2.5rem);
    align-items: start;
    padding-block: clamp(1.25rem, 3vw, 2rem);
    border-block-end: 1px solid var(--card-edge);
  }
  .research-summary h3 {
    font-size: clamp(1.3rem, 1.12rem + 0.65vw, 1.75rem);
    text-wrap: pretty;
  }
  .research-summary p {
    margin-block-start: 0.5rem;
    max-inline-size: 65ch;
    color: var(--secondary-text);
  }
  .research-context {
    display: grid;
    justify-items: start;
    gap: 0.45rem;
  }
  .research-meta {
    font-size: 0.95rem;
    color: var(--secondary-text);
  }
  .research-meta div + div {
    margin-block-start: 0.2rem;
  }
  @media (max-width: 42rem) {
    .research-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.65rem;
    }
  }
</style>
