---
import DirectoryCatalog from '../components/directory/DirectoryCatalog.astro';
import DirectoryResult from '../components/directory/DirectoryResult.astro';
import ResearchCard from '../components/research/ResearchCard.astro';
import CompactHero from '../components/site/CompactHero.astro';
import EditorialMotion from '../components/site/EditorialMotion.astro';
import { sortDirectory, sortOptions } from '../data/directory';
import { getResearch, researchSection } from '../data/research';
import { indexResearch, researchFacets } from '../data/research-directory';
import InteriorLayout from '../layouts/InteriorLayout.astro';

const entries = (await getResearch()).map((entry) => ({
  entry,
  index: indexResearch(entry),
}));
entries.sort((a, b) => sortDirectory(a.index, b.index, 'recent'));
const { primary, secondary } = researchFacets(
  entries.map(({ index }) => index),
);
---

<InteriorLayout
  title="Investigación en IA y trabajos originales | AI PlayGrounds"
  description="Conoce la investigación de AI PlayGrounds y su colección de trabajos originales sobre inteligencia artificial o realizados con su apoyo."
>
  <CompactHero
    id="DI1"
    variant="exploration"
    title="Exploramos nuevas preguntas con inteligencia artificial."
    description="Desarrollamos y compartimos trabajos de investigación para comprender la IA, explorar sus aplicaciones y generar conocimiento."
  />
  <DirectoryCatalog
    directory="research"
    sectionId={researchSection}
    title="Directorio de investigaciones"
    singular="investigación"
    plural="investigaciones"
    emptyMessage="Aún no hay investigaciones publicadas."
    placeholder="Buscar por título, autoría, tema o método…"
    total={entries.length}
    {primary}
    {secondary}
    defaultView="list"
    labels={{
      ...sortOptions,
      recent: 'Publicadas recientemente',
      updated: 'Actualizadas recientemente',
      az: 'Título A–Z',
      za: 'Título Z–A',
    }}
  >
    {entries.map(({ entry, index }, position) => (
      <DirectoryResult {index} reveal>
        <ResearchCard {entry} eager={position === 0} />
      </DirectoryResult>
    ))}
  </DirectoryCatalog>
  <EditorialMotion />
</InteriorLayout>
