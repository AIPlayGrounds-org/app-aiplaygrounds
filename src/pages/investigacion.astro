---
import { research } from '../data/directories';
import InteriorLayout from '../layouts/InteriorLayout.astro';
import ClosingCTA from '../components/site/ClosingCTA.astro';
import DirectoryCard from '../components/site/DirectoryCard.astro';

const entries = import.meta.env.DEV
  ? [...research, ...(await import('../data/directories.demo')).demoResearch]
  : research;
---

<InteriorLayout
  title="Investigación en IA y trabajos originales | AI PlayGrounds"
  description="Trabajos originales sobre IA o realizados con su apoyo: criterios de autoría, método, resultados y límites para seguir cada pregunta hasta su fuente."
>
  <section id="DI1" class="page-hero">
    <div class="site-container">
      <h1>Investigaciones y trabajos relacionados con IA</h1>
      <div class="lead">
        <p>
          Esta colección está dedicada a trabajos originales sobre inteligencia
          artificial o realizados con su apoyo. Su punto de partida es la
          pregunta: qué intenta responder el trabajo, cómo la aborda y qué
          sostiene su fuente.
        </p>
        <p>
          Autoría, tipo, fecha, método y límites ayudan a leer cada aporte en su
          contexto. La relación con AI PlayGrounds se indica por separado, tanto
          en trabajos propios o vinculados como en externos. La revisión por
          pares solo se señala cuando está documentada.
        </p>
      </div>
      <a class="interior-link" href="#DI2">
        Ver investigaciones ↓
      </a>
    </div>
  </section>
  <section id="DI2" class="interior-section">
    <div class="site-container">
      <h2>Directorio de investigaciones</h2>
      {entries.length === 0 ? (
        <p class="directory-empty">
          Aún no hay investigaciones en el directorio.
        </p>
      ) : (
        <div class="interior-grid">
          {entries.map((item) => (
            <DirectoryCard
              title={item.title}
              description={item.question}
              details={[
                [item.authors, item.date].filter(Boolean).join(' · '),
                item.type,
              ].filter(Boolean)}
              demo={'demo' in item}
              source={item.source}
            />
          ))}
        </div>
      )}
    </div>
  </section>
  <ClosingCTA
    id="DI4"
    title="La investigación dentro de AI PlayGrounds"
    paragraphs={[
      'AI Foundations, AI for Science, AI for Software y AI for Finance abren preguntas distintas sobre la IA. En Inicio puedes situarlas dentro del propósito de AI PlayGrounds.',
    ]}
    buttons={[
      { label: 'Conocer AI PlayGrounds', href: '/', variant: 'primary' },
    ]}
  />
</InteriorLayout>
