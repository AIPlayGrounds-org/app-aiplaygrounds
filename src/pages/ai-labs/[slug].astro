---
import type { GetStaticPaths } from 'astro';
import {
  ArrowUpRight,
  Building,
  BuildingComplex,
  CalendarDays,
  CodeXml,
  Info,
  Layers,
  MessageSquare,
  Search,
  TrendingUp,
  UserRound,
  UsersRound,
  Workflow,
} from '@lucide/astro';
import { getProducts, productAuthors, type Product } from '../../data/labs';
import ProductCard from '../../components/labs/ProductCard.astro';
import ProductCover from '../../components/labs/ProductCover.astro';
import DirectoryBack from '../../components/directory/DirectoryBack.astro';
import MetadataPanel from '../../components/directory/MetadataPanel.astro';
import ShareEntry from '../../components/directory/ShareEntry.astro';
import EditorialMotion from '../../components/site/EditorialMotion.astro';
import Button from '../../components/ui/Button.astro';
import InteriorLayout from '../../layouts/InteriorLayout.astro';
import '../../styles/labs-detail.css';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  const byId = new Map(products.map((product) => [product.id, product]));
  return products.map((product) => ({
    params: { slug: product.slug },
    props: {
      product,
      related: [...new Set(product.related)].flatMap((id) => {
        const entry = byId.get(id);
        return entry && entry.id !== product.id && entry.demo === product.demo
          ? [entry]
          : [];
      }),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  product: Product;
  related: Product[];
}
const { product, related } = Astro.props;
const capabilityIcons = {
  code: CodeXml,
  layers: Layers,
  message: MessageSquare,
  search: Search,
  workflow: Workflow,
};
const scopeIcons = {
  Individual: UserRound,
  Team: UsersRound,
  Organization: Building,
  Enterprise: BuildingComplex,
};
const metadata: [string, string | undefined, string?][] = [
  ['Categoría', product.category],
  ['Área de aplicación', product.application],
  ['Tipo de producto', product.type],
  ['Madurez', product.maturity, 'en'],
  ['Estado de desarrollo', product.development, 'en'],
  ['Alcance de uso', product.scopes.join(', '), 'en'],
  ['Relación con IA', product.aiRelationship],
  ['Licencia', product.license],
  ['Precio', product.price],
];
const dates = [
  ['Publicado', product.publishedAt],
  ['Última actualización', product.updatedAt],
  ['Información verificada', product.verifiedAt],
];
const dateFormat = new Intl.DateTimeFormat('es', {
  dateStyle: 'long',
  timeZone: 'UTC',
});
const accessText = {
  Público: 'No hay un enlace de acceso publicado para este producto.',
  'Por invitación': 'Este producto solo está disponible por invitación.',
  Privado: 'Este producto es de acceso privado.',
  'No disponible': 'Este producto no está disponible para su uso.',
};
---

<InteriorLayout
  title={`${product.name} | AI Labs | AI PlayGrounds`}
  description={product.summary}
>
  <article class="site-container labs-detail">
    <DirectoryBack href="/ai-labs/#B3" title="AI Labs" />
    <ProductCover {product} detail />
    <div class="product-layout">
      <div class="product-content">
        <header class="product-intro" data-product-intro>
          <h1>{product.name}</h1>
          <p class="product-summary">{product.summary}</p>
          <div class="product-byline">
            <p>
              Por {productAuthors(product)}
              {product.demo && <small>Demostración</small>}
            </p>
          </div>
        </header>
        <section class="detail-panel access-panel" data-product-access>
          <h2>Modalidad de acceso</h2>
          <p class="access-mode">{product.access}</p>
          {product.url ? (
            <Button href={product.url} variant="primary">
              Acceder al producto <ArrowUpRight size={18} aria-hidden="true" />
            </Button>
          ) : (
            <p class="access-note">
              {product.accessNote ?? accessText[product.access]}
            </p>
          )}
          <ShareEntry />
        </section>
        <section>
          <h2>Sobre el producto</h2>
          <p class="product-prose">{product.description}</p>
          {product.media.length > 0 && (
            <ul
              class="product-media"
              aria-label="Imágenes del producto"
              role="list"
            >
              {product.media.map(({ src, alt, width, height }) => (
                <li>
                  <img
                    {src}
                    {alt}
                    {width}
                    {height}
                    loading="lazy"
                    decoding="async"
                  />
                </li>
              ))}
            </ul>
          )}
        </section>
        {product.problem && (
          <section>
            <h2>¿Qué problema resuelve?</h2>
            <p class="product-prose">{product.problem}</p>
          </section>
        )}
        {product.capabilities.length > 0 && (
          <section>
            <h2>Principales capacidades</h2>
            <ul class="capabilities" role="list">
              {product.capabilities.map(({ title, description, icon }) => {
                const Icon = icon ? capabilityIcons[icon] : Layers;
                return (
                  <li class="icon-row">
                    <span class="detail-icon">
                      <Icon size={21} aria-hidden="true" />
                    </span>
                    <div>
                      <h3>{title}</h3>
                      <p>{description}</p>
                    </div>
                  </li>
                );
              })}
            </ul>
          </section>
        )}
        {(product.audience || product.scopes.length > 0) && (
          <section>
            <h2>¿A quién está dirigido?</h2>
            {product.audience && (
              <p class="product-prose">{product.audience}</p>
            )}
            {product.scopes.length > 0 && (
              <ul class="audience-list" role="list">
                {product.scopes.map((scope) => {
                  const Icon = scopeIcons[scope];
                  const description = product.audienceByScope[scope];
                  return (
                    <li>
                      <h3 lang="en">
                        <Icon size={18} aria-hidden="true" />
                        {scope}
                      </h3>
                      {description && <p>{description}</p>}
                    </li>
                  );
                })}
              </ul>
            )}
          </section>
        )}
        <section>
          <h2>Tecnología e inteligencia artificial</h2>
          <p>
            <strong>Relación con IA:</strong>{' '}
            {product.aiRelationship === 'Ambas'
              ? 'IA integrada y utilizada durante el desarrollo'
              : product.aiRelationship}
          </p>
          {product.technicalDetails && (
            <p class="product-prose">{product.technicalDetails}</p>
          )}
          {product.technologies.length > 0 && (
            <ul class="technology-list" aria-label="Tecnologías" role="list">
              {product.technologies.map((technology) => (
                <li>{technology}</li>
              ))}
            </ul>
          )}
        </section>
        {product.evidence && (
          <section>
            <h2>Estado y evidencia de uso</h2>
            <div class="icon-row">
              <span class="detail-icon">
                <TrendingUp size={21} aria-hidden="true" />
              </span>
              <p class="product-prose">{product.evidence}</p>
            </div>
          </section>
        )}
        {product.limitations && (
          <section>
            <h2>Consideraciones y limitaciones</h2>
            <div class="icon-row">
              <span class="detail-icon">
                <Info size={21} aria-hidden="true" />
              </span>
              <p class="product-prose">{product.limitations}</p>
            </div>
          </section>
        )}
      </div>

      <aside
        class="product-sidebar"
        aria-label="Metadatos y autoría"
        data-product-sidebar
      >
        <MetadataPanel
          title="Información del producto"
          icon={Info}
          fields={metadata}
        />
        <section class="detail-panel">
          <h2>
            <UsersRound size={21} aria-hidden="true" />
            Creado por
          </h2>
          <ul class="author-list" role="list">
            {product.authors.map(({ name, avatar }) => (
              <li class="icon-row">
                {avatar && (
                  <img
                    src={avatar.src}
                    alt=""
                    width={avatar.width}
                    height={avatar.height}
                    loading="lazy"
                    decoding="async"
                  />
                )}
                <strong>{name}</strong>
              </li>
            ))}
          </ul>
          <dl>
            {product.team && (
              <div>
                <dt>Equipo responsable</dt>
                <dd>{product.team}</dd>
              </div>
            )}
            <div>
              <dt>Procedencia</dt>
              <dd>{product.origin}</dd>
            </div>
            {product.verticals.length > 0 && (
              <div>
                <dt>Vertical asociada</dt>
                <dd lang="en">{product.verticals.join(', ')}</dd>
              </div>
            )}
          </dl>
          {product.organizationRelation && (
            <p class="author-context">{product.organizationRelation}</p>
          )}
        </section>
        <section class="detail-panel">
          <h2>
            <CalendarDays size={21} aria-hidden="true" />
            Fechas
          </h2>
          <dl>
            {dates.map(
              ([label, value]) =>
                value && (
                  <div>
                    <dt>{label}</dt>
                    <dd>
                      <time datetime={value}>
                        {dateFormat.format(new Date(value))}
                      </time>
                    </dd>
                  </div>
                ),
            )}
          </dl>
        </section>
      </aside>
    </div>

    {related.length > 0 && (
      <section
        class="related-products"
        aria-labelledby="related-products-title"
        data-related-directory
        data-reveal="fade"
      >
        <h2 id="related-products-title">
          <Layers size={24} aria-hidden="true" />
          Productos relacionados
        </h2>
        <ul data-view="list" role="list">
          {related.map((entry) => (
            <li>
              <ProductCard product={entry} />
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
  <EditorialMotion />
</InteriorLayout>

<script>
  const intro = document.querySelector<HTMLElement>('[data-product-intro]')!;
  const access = document.querySelector<HTMLElement>('[data-product-access]')!;
  const sidebar = document.querySelector<HTMLElement>(
    '[data-product-sidebar]',
  )!;
  const twoColumns = matchMedia('(min-width: 52rem)');
  function placeAccess() {
    const focused = document.activeElement;
    if (twoColumns.matches) sidebar.prepend(access);
    else intro.after(access);
    if (focused instanceof HTMLElement && access.contains(focused))
      focused.focus({ preventScroll: true });
  }
  if (twoColumns.matches) placeAccess();
  twoColumns.addEventListener('change', placeAccess);
</script>
