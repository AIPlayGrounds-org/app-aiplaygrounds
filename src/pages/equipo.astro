---
import {
  Brain,
  ChartNoAxesCombined,
  CodeXml,
  FlaskConical,
} from '@lucide/astro';
import TeamGrid from '../components/team/TeamGrid.astro';
import ClosingCTA from '../components/site/ClosingCTA.astro';
import CompactHero from '../components/site/CompactHero.astro';
import EditorialMotion from '../components/site/EditorialMotion.astro';
import { teamVerticals } from '../data/team';
import InteriorLayout from '../layouts/InteriorLayout.astro';

const verticalIcons = {
  software: CodeXml,
  science: FlaskConical,
  finance: ChartNoAxesCombined,
  foundations: Brain,
};
---

<InteriorLayout
  title="Equipo y organización | AI PlayGrounds"
  description="Conoce al equipo de AI PlayGrounds y a las personas que aprenden, investigan, experimentan y construyen con inteligencia artificial."
>
  <CompactHero
    id="E1"
    variant="convergence"
    title="Las personas que impulsan AI PlayGrounds."
    description="Somos un equipo que reúne distintas experiencias y conocimientos para aprender, investigar, experimentar y construir con inteligencia artificial."
  />

  <div id="E3" class="site-container roster">
    <section aria-labelledby="direccion">
      <h2 id="direccion">Dirección</h2>
      <TeamGrid group="direction" />
    </section>

    <section aria-labelledby="organizacion">
      <h2 id="organizacion">Equipo de organización</h2>
      <TeamGrid group="organization" />
    </section>

    <section aria-labelledby="verticales">
      <header class="verticals-intro">
        <h2 id="verticales">Equipos por vertical</h2>
        <p>
          Personas que exploran y construyen desde diferentes áreas de la
          inteligencia artificial.
        </p>
      </header>
      <div class="verticals">
        {teamVerticals.map(({ id, title }) => {
          const Icon = verticalIcons[id];
          return (
            <section aria-labelledby={`vertical-${id}`}>
              <h3 id={`vertical-${id}`} class="vertical-title">
                <span class="vertical-icon" data-vertical={id}>
                  <Icon class="size-icon-lg" aria-hidden="true" />
                </span>
                {title}
              </h3>
              <TeamGrid group="vertical" vertical={id} />
            </section>
          );
        })}
      </div>
    </section>
  </div>

  <ClosingCTA
    id="E4"
    density="compact"
    title="Acércate desde la comunidad"
    paragraphs={[
      'Conecta con personas interesadas en inteligencia artificial y conoce lo que estamos construyendo.',
    ]}
    buttons={[
      { label: 'Ir a la comunidad', href: '/comunidad/', variant: 'primary' },
      { label: 'Explorar AI Labs', href: '/ai-labs/', variant: 'outline' },
    ]}
  />
  <EditorialMotion />
</InteriorLayout>

<style>
  .vertical-icon[data-vertical='foundations'] {
    background: var(--terrain-connection-light);
  }
  .roster {
    display: grid;
    gap: clamp(2.25rem, 4.5vw, 4rem);
    max-inline-size: 68rem;
    padding-block: clamp(2rem, 4vw, 3.5rem);
  }
  .roster h2 {
    margin-block-end: clamp(1rem, 1.8vw, 1.5rem);
    font-size: clamp(1.5rem, 1.35rem + 0.65vw, 1.875rem);
  }
  .verticals-intro h2 {
    margin-block-end: var(--space-related);
  }
  .verticals-intro p {
    max-inline-size: 58ch;
    color: var(--secondary-text);
  }
  .verticals {
    display: grid;
    gap: clamp(1.75rem, 3.3vw, 2.75rem);
    margin-block-start: clamp(1.25rem, 2.7vw, 2rem);
  }
  .vertical-title {
    display: flex;
    align-items: center;
    gap: var(--space-control);
    margin-block-end: var(--space-control);
    font-size: clamp(1.1875rem, 1.1rem + 0.35vw, 1.375rem);
    text-wrap: pretty;
  }
  .vertical-icon {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border-radius: var(--editorial-radius);
    background: var(--editorial-lilac);
    color: var(--foreground);
  }
  .vertical-icon[data-vertical='science'] {
    background: var(--editorial-grove);
  }
  .vertical-icon[data-vertical='finance'] {
    background: var(--editorial-sand);
  }
</style>
