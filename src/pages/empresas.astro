---
import { empresasImages } from '../assets/empresas';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import ImmersiveHero from '../components/site/ImmersiveHero.astro';
import Section from '../components/site/Section.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
import TextLink from '../components/site/TextLink.astro';
import CollaborationCard from '../components/site/CollaborationCard.astro';
import InitiativeCard from '../components/site/InitiativeCard.astro';
import InitiativeGrid from '../components/site/InitiativeGrid.astro';
import EditorialMotion from '../components/site/EditorialMotion.astro';
import OrganizationContactForm from '../components/site/OrganizationContactForm.astro';
import FormCTA from '../components/site/FormCTA.astro';
---

<BaseLayout
  title="Alianzas y oportunidades de IA para organizaciones | AI PlayGrounds"
  description="Explora alianzas institucionales, proyectos de IA y formación para equipos. Conversemos sobre las necesidades de tu organización."
  bodyClass="organizations"
>
  <SiteHeader immersive />
  <main id="contenido" tabindex="-1">
    <ImmersiveHero
      id="EM1"
      image={empresasImages.hero}
      title="Conecta tu organización con nuevas oportunidades en IA."
      description="Explora alianzas, proyectos y oportunidades de colaboración en inteligencia artificial a partir de las necesidades de tu organización."
      align="start"
      position="center 40%"
      mobilePosition="34% center"
      imageSizes="(max-width: 40rem) 768px, (max-width: 60rem) 1024px, 100vw"
    >
      <Button href="#EM6" variant="primary" data-cta="hero_contact">
        Conversemos
      </Button>
      <Button href="#EM2" variant="outline" data-cta="hero_opportunities">
        Explorar oportunidades
      </Button>
    </ImmersiveHero>

    <Section id="EM2" tabindex="-1" aria-labelledby="opportunities-title">
      <div class="section-intro" data-reveal>
        <SectionHeading id="opportunities-title">
          Exploremos qué podemos hacer juntos
        </SectionHeading>
        <p>
          Cada organización llega con necesidades diferentes. Estas son dos
          maneras de iniciar una colaboración con AI PlayGrounds.
        </p>
      </div>
      <div class="collaborations">
        <CollaborationCard
          title="Alianzas institucionales"
          description="Actividades conjuntas, colaboración entre comunidades, universidades e instituciones e iniciativas vinculadas con IA."
          image={empresasImages.bridge}
          tone="grove"
          href="#EM6"
          label="Proponer una alianza"
          ctaId="propose_alliance"
          inquiryType="institutional"
        />
        <CollaborationCard
          title="Oportunidades comerciales"
          description="Necesidades de IA, proyectos e iniciativas que requieran explorar capacidades técnicas o formación para equipos."
          image={empresasImages.terraces}
          tone="sand"
          href="#EM6"
          label="Plantear una necesidad"
          ctaId="propose_need"
          inquiryType="commercial"
        />
      </div>
    </Section>

    <Section id="EM3" class="trajectory" aria-labelledby="trajectory-title">
      <SectionHeading id="trajectory-title" data-reveal>
        Una trayectoria construida en colaboración
      </SectionHeading>
      <div class="section-intro" data-reveal>
        <p>
          Hemos coorganizado hackathons y encuentros junto a organizaciones del
          ecosistema tecnológico, además de impulsar experiencias formativas que
          reúnen a personas alrededor de la IA.
        </p>
        <TextLink href="/#I4" data-cta="view_trajectory">
          Conoce nuestra trayectoria
        </TextLink>
      </div>
    </Section>

    <Section id="EM4" aria-labelledby="initiatives-title">
      <SectionHeading id="initiatives-title" data-reveal>
        Conoce nuestras iniciativas
      </SectionHeading>
      <InitiativeGrid>
        <InitiativeCard
          illustration="labs"
          title="AI Labs"
          description="Iniciativas y productos tempranos que exploran ideas y aplicaciones de inteligencia artificial."
          href="/ai-labs/"
          label="Explorar AI Labs"
          ctaId="explore_labs"
        />
        <InitiativeCard
          id="EM5"
          illustration="academy"
          title="AI Academy"
          description="Aprendizaje en IA y posibilidad de explorar propuestas formativas para equipos."
          href="#EM6"
          label="Consultar formación"
          ctaId="ask_training"
          inquiryType="commercial"
        />
        <InitiativeCard
          illustration="research"
          title="Investigación"
          description="Preguntas, líneas y trabajos de investigación relacionados con inteligencia artificial y sus aplicaciones."
          href="/investigacion/"
          label="Explorar investigación"
          ctaId="explore_research"
        />
      </InitiativeGrid>
    </Section>

    <FormCTA
      id="EM6"
      headingId="contact-title"
      title="Conversemos sobre tu organización"
      description="Cuéntanos qué tienes en mente. No necesitas tener un proyecto completamente definido para iniciar una conversación."
      illustration={empresasImages.patio}
      illustrationBleed="1.65%"
      density="compact"
    >
      <OrganizationContactForm />
    </FormCTA>
  </main>
  <SiteFooter />
  <EditorialMotion />
</BaseLayout>

<script>
  import { trackLinks } from '../scripts/analytics';
  import { wireSectionLinks } from '../scripts/section-links';

  wireSectionLinks(document);
  trackLinks(document, '/empresas/');
</script>

<style>
  :global(body.organizations) {
    --home-background: var(--editorial-background);
    --home-surface: var(--editorial-surface);
    --home-card: var(--editorial-card);
    background: var(--editorial-background);
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(html:has(body.organizations)) {
      scroll-behavior: smooth;
    }
  }
  :global(body.organizations main [id]) {
    scroll-margin-top: 0.5rem;
  }
  .section-intro p {
    max-width: 60ch;
    color: var(--secondary-text);
  }
  .section-intro > :global(h2) + p {
    margin-top: 0.75rem;
  }
  .collaborations {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-top: 2rem;
  }
  .trajectory {
    padding-block: clamp(1.5rem, 3vw, 3rem);
    display: grid;
    align-items: start;
    gap: 1rem;
  }
  .trajectory > :global(h2) {
    max-width: 20ch;
  }
  .trajectory :global(.text-link) {
    margin-top: 0.5rem;
  }
  @media (min-width: 48rem) {
    .trajectory {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(2rem, 6vw, 6rem);
    }
    .trajectory .section-intro {
      --editorial-delay: 95ms;
    }
  }
  @media (min-width: 60rem) {
    .collaborations {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
