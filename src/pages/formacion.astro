---
import { Image } from 'astro:assets';
import {
  ArrowDown,
  Braces,
  Blocks,
  Hammer,
  ScanLine,
  Shuffle,
} from '@lucide/astro';
import { inicioImages } from '../assets/inicio';
import InteriorLayout from '../layouts/InteriorLayout.astro';
import Button from '../components/starwind/button/Button.astro';

const pillars = [
  {
    title: 'Aplicación práctica',
    text: 'Construye una solución para un problema real de tu trabajo o de un proyecto propio.',
    icon: Hammer,
  },
  {
    title: 'Criterio técnico',
    text: 'Entiende cómo funciona tu solución, comprueba el resultado y decide qué mejorar.',
    icon: ScanLine,
  },
  {
    title: 'Autonomía',
    text: 'Aplica lo aprendido a un reto nuevo, aunque cambie la herramienta o el problema.',
    icon: Shuffle,
  },
];
const lines = [
  {
    id: 'software-with-ai',
    title: 'Software with AI',
    label: 'IA durante el desarrollo',
    text: 'Usa IA para mejorar cómo desarrollas, pruebas y mantienes software.',
    option: 'Usa IA para desarrollar mejor software.',
    icon: Braces,
  },
  {
    id: 'ai-engineering',
    title: 'AI Engineering',
    label: 'IA dentro de la aplicación',
    text: 'Integra capacidades de IA en las aplicaciones y sistemas que construyes.',
    option: 'Integra IA en tus aplicaciones y sistemas.',
    icon: Blocks,
  },
];
const formats = [
  ['Workshop', 'Una sesión breve para trabajar una tarea concreta.'],
  ['Full Day', 'Una jornada para desarrollar y revisar una solución.'],
  [
    'Curso corto',
    'Varias sesiones para construir y mejorar una solución por etapas.',
  ],
];
---

<InteriorLayout
  title="AI Academy: formación en IA para desarrollar software | AI PlayGrounds"
  description="Conoce Software with AI y AI Engineering, las dos líneas formativas de AI Academy."
>
  <div class="academy">
    <section
      class="academy-hero site-container"
      aria-labelledby="academy-title"
    >
      <div class="hero-copy">
        <div class="identity">AI Academy</div>
        <h1 id="academy-title">
          Amplía lo que eres capaz de construir con IA.
        </h1>
        <p>
          Desarrolla las capacidades para crear software con IA e integrarla en
          tus aplicaciones con criterio y autonomía.
        </p>
        <Button href="#F3" variant="primary" class="academy-button">
          Ver enfoques <ArrowDown size={18} aria-hidden="true" />
        </Button>
      </div>
      <Image
        class="hero-art"
        src={inicioImages.finance}
        alt=""
        format="webp"
        widths={[400, 640, 960, 1280]}
        sizes="(max-width: 48rem) 92vw, (min-width: 87rem) 620px, 45vw"
      />
    </section>

    <section class="approach" aria-labelledby="approach-title">
      <div class="site-container">
        <h2 id="approach-title">
          Construye con IA. Entiende lo que construyes.
        </h2>
        <ul class="pillars" role="list">
          {pillars.map(({ title, text, icon: Icon }) => (
            <li>
              <Icon size={25} stroke-width={1.5} aria-hidden="true" />
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="F3" class="site-container lines" aria-labelledby="lines-title">
      <h2 id="lines-title">Dos líneas formativas</h2>
      <div class="comparison">
        {lines.map(({ title, label, text, icon: Icon }) => (
          <article>
            <Icon size={30} stroke-width={1.5} aria-hidden="true" />
            <h3>{title}</h3>
            <p class="line-label">{label}</p>
            <p>{text}</p>
          </article>
        ))}
      </div>
      <p class="lines-note">
        Son enfoques independientes. Elige según lo que quieras construir.
      </p>
    </section>

    <section class="site-container formats" aria-labelledby="formats-title">
      <div>
        <h2 id="formats-title">Formatos</h2>
        <p>Por ahora no hay convocatorias abiertas.</p>
      </div>
      <dl>
        {formats.map(([title, text]) => (
          <div>
            <dt>{title}</dt>
            <dd>{text}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="site-container waitlist" aria-labelledby="waitlist-title">
      <article class="waitlist-card">
        <div class="waitlist-intro">
          <h2 id="waitlist-title">Lista de espera</h2>
          <p>
            Déjanos tus datos y te avisaremos cuando abramos una convocatoria en
            la línea que elijas.
          </p>
          <p id="waitlist-availability" class="availability-note">
            La lista de espera aún no está abierta.
          </p>
        </div>
        <form
          id="academy-form"
          action="/api/academy-waitlist"
          method="post"
          aria-labelledby="waitlist-title"
          aria-describedby="waitlist-availability"
        >
          <div class="field">
            <label for="academy-name">Nombre</label>
            <input
              id="academy-name"
              name="name"
              autocomplete="name"
              maxlength="120"
              required
              disabled
            />
          </div>
          <div class="field">
            <label for="academy-email">Correo electrónico</label>
            <input
              id="academy-email"
              name="email"
              type="email"
              autocomplete="email"
              maxlength="254"
              required
              disabled
            />
          </div>
          <fieldset disabled>
            <legend>Línea formativa</legend>
            {lines.map(({ id, title, option }) => (
              <label class="choice" for={id}>
                <input type="radio" {id} name="line" value={id} required />
                <span>
                  <strong>{title}</strong> — {option}
                </span>
              </label>
            ))}
          </fieldset>
          <div class="submit-area">
            <Button
              type="submit"
              variant="primary"
              class="academy-button"
              disabled
            >
              Avisarme
            </Button>
          </div>
        </form>
      </article>
    </section>
  </div>
</InteriorLayout>

<style>
  .academy h2 {
    font-size: clamp(1.85rem, 1.35rem + 2vw, 3.25rem);
  }
  .academy p {
    color: var(--secondary-text);
  }
  .academy-hero {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: clamp(1.25rem, 4vw, 3.5rem);
    padding-block: clamp(6rem, 8vw, 7.5rem) clamp(2rem, 4.5vw, 4rem);
  }
  .hero-copy {
    display: grid;
    justify-items: start;
    gap: 1rem;
  }
  .identity {
    font: 600 1.15rem var(--font-heading);
  }
  .hero-copy h1 {
    font-size: clamp(2.25rem, 1.5rem + 2.5vw, 3.5rem);
    max-width: 21ch;
  }
  .hero-copy p {
    max-width: 46ch;
    font-size: clamp(1.05rem, 0.975rem + 0.4vw, 1.25rem);
  }
  .hero-art {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: right bottom;
    border-radius: 0.5rem;
  }
  .academy :global(.academy-button) {
    min-height: 3rem;
    align-self: start;
  }
  .approach {
    color: var(--foreground);
    padding-block: clamp(2.75rem, 5vw, 5rem);
  }
  .approach h2 {
    max-width: 24ch;
    text-wrap: wrap;
  }
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-top: clamp(1.75rem, 4vw, 3rem);
  }
  .pillars :global(svg) {
    color: var(--foreground);
    margin-bottom: 0.9rem;
  }
  .pillars p,
  .comparison p {
    margin-top: 0.5rem;
    max-width: 42ch;
  }
  .lines {
    padding-block: clamp(3rem, 6vw, 6rem) clamp(2rem, 4vw, 4rem);
  }
  .comparison {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .comparison article {
    padding: clamp(1.25rem, 3vw, 2.5rem);
    background: var(--home-card);
    border: 1px solid var(--border);
    border-radius: 0.4rem;
  }
  .comparison :global(svg) {
    margin-bottom: 1rem;
  }
  .comparison h3 {
    font-size: clamp(1.45rem, 1.1rem + 1.1vw, 2rem);
    text-wrap: wrap;
  }
  .academy .line-label {
    color: var(--foreground);
    font-weight: 500;
  }
  .lines-note {
    margin-top: 1rem;
  }
  .formats {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 1.5rem;
    padding-block: clamp(1rem, 3vw, 2.5rem) clamp(2.75rem, 6vw, 5rem);
  }
  .formats h2 + p,
  .waitlist h2 + p {
    margin-top: 0.75rem;
  }
  .formats dl {
    margin: 0;
  }
  .formats dl div {
    display: grid;
    grid-template-columns: 11ch 1fr;
    gap: 1rem;
    padding-block: 0.75rem;
  }
  .formats dl div + div {
    border-top: 1px solid var(--border);
  }
  .formats dt {
    font-weight: 600;
  }
  .formats dd {
    color: var(--secondary-text);
  }
  .waitlist {
    margin-bottom: clamp(2rem, 5vw, 5rem);
  }
  .waitlist-card {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(1.75rem, 6vw, 6rem);
    padding: clamp(1.25rem, 5vw, 4.5rem);
    background: var(--home-surface);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
  }
  .waitlist-intro p {
    max-width: 36ch;
  }
  .waitlist .availability-note {
    margin-top: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
  }
  form,
  .field {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    min-width: 0;
  }
  .field {
    gap: 0.375rem;
  }
  .field label,
  legend {
    font-weight: 600;
  }
  .field input {
    width: 100%;
    min-height: 3rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--input);
    border-radius: 0.25rem;
    background: var(--home-card);
    font: inherit;
  }
  .field input:disabled {
    background: var(--home-background);
    cursor: not-allowed;
  }
  fieldset {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }
  legend {
    margin-bottom: 0.5rem;
  }
  .choice {
    display: flex;
    align-items: start;
    gap: 0.7rem;
    min-height: 3rem;
    padding: 0.65rem 0.75rem;
    border: 1px solid var(--input);
    border-radius: 0.25rem;
    background: var(--home-card);
    cursor: pointer;
  }
  .choice input {
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.15rem;
  }
  .choice:has(:checked) {
    background: var(--home-background);
    border-color: var(--primary);
  }
  .choice:has(:disabled) {
    background: var(--home-background);
    cursor: not-allowed;
  }
  .submit-area {
    display: grid;
    justify-items: start;
  }
  @media (max-width: 48rem) {
    .academy-hero,
    .formats,
    .waitlist-card {
      grid-template-columns: 1fr;
    }
    .academy-hero {
      padding-block: 5.5rem 2rem;
    }
    .hero-art {
      aspect-ratio: 2 / 1;
    }
    .pillars {
      grid-template-columns: 1fr;
    }
    .pillars li {
      display: grid;
      grid-template-columns: 1.6rem 1fr;
      gap: 0.2rem 0.75rem;
      align-items: center;
    }
    .pillars :global(svg) {
      margin: 0;
    }
    .pillars p {
      grid-column: 2;
      margin: 0;
    }
  }
  @media (max-width: 38rem) {
    .comparison {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 23rem) {
    .waitlist-card {
      padding-inline: 0.75rem;
    }
  }
</style>
