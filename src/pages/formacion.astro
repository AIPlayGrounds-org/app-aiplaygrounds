---
import { ArrowDown } from '@lucide/astro';
import { academyImages } from '../assets/academy';
import AcademyMotif from '../components/site/AcademyMotif.astro';
import ClosingCTA from '../components/site/ClosingCTA.astro';
import EditorialMotion from '../components/site/EditorialMotion.astro';
import FormCTA from '../components/site/FormCTA.astro';
import FormField from '../components/composed/FormField.astro';
import Radio from '../components/ui/Radio.astro';
import ImmersiveCard from '../components/site/ImmersiveCard.astro';
import ImmersiveHero from '../components/site/ImmersiveHero.astro';
import InformationalCard from '../components/site/InformationalCard.astro';
import Section from '../components/site/Section.astro';
import SectionHeading from '../components/site/SectionHeading.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteHeader from '../components/site/SiteHeader.astro';
import TextLink from '../components/site/TextLink.astro';
import Button from '../components/ui/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const pillars = [
  {
    title: 'Aplicación práctica',
    description:
      'Construye soluciones para problemas reales de tu trabajo o de tus propios proyectos.',
    icon: 'practice',
  },
  {
    title: 'Criterio técnico',
    description:
      'Comprende cómo funcionan tus soluciones, evalúa sus resultados y decide qué mejorar.',
    icon: 'judgment',
  },
  {
    title: 'Autonomía',
    description:
      'Aplica lo aprendido a nuevos desafíos, aunque cambien las herramientas.',
    icon: 'autonomy',
  },
] as const;

const lines = [
  {
    value: 'software-with-ai',
    title: 'Software with AI',
    eyebrow: 'IA durante el desarrollo',
    description:
      'Aprende a utilizar IA para mejorar cómo desarrollas, pruebas y mantienes software, conservando el control sobre tus decisiones técnicas.',
    image: academyImages.software,
  },
  {
    value: 'ai-engineering',
    title: 'AI Engineering',
    eyebrow: 'IA dentro de la aplicación',
    description:
      'Aprende a integrar capacidades de inteligencia artificial en aplicaciones y sistemas, comprendiendo su funcionamiento, evaluación y límites.',
    image: academyImages.engineering,
  },
];

const formats = [
  {
    title: 'Workshop',
    description:
      'Sesiones prácticas enfocadas en una tarea o desafío concreto.',
    icon: 'workshop',
    tone: 'grove',
  },
  {
    title: 'Full Day',
    description: 'Una jornada intensiva de aprendizaje y construcción.',
    icon: 'day',
    tone: 'rose',
  },
  {
    title: 'Cursos',
    description:
      'Varias sesiones para desarrollar capacidades y construir soluciones por etapas.',
    icon: 'courses',
    tone: 'lilac',
  },
] as const;

const metrics = [
  ['300+', 'inscritos'],
  ['16', 'speakers'],
  ['6', 'semanas'],
];
---

<BaseLayout
  title="AI Academy: formación en IA para desarrollar software | AI PlayGrounds"
  description="Conoce Software with AI y AI Engineering, las dos líneas formativas de AI Academy. No hay convocatorias abiertas."
  bodyClass="academy"
  editorial
>
  <SiteHeader immersive />
  <main id="contenido" tabindex="-1">
    <ImmersiveHero
      id="F1"
      image={academyImages.hero}
      composition="open-sky"
      position="center"
      imageSizes="(max-width: 40rem) 1024px, (max-width: 74rem) 1200px, 100vw"
      title="Amplía lo que eres capaz de construir con IA."
      description="Desarrolla capacidades para crear software con IA e integrarla en tus aplicaciones con criterio y autonomía."
    >
      <Button
        href="#F3"
        variant="primary"
        data-surface-motion
        style="--arrow-x: 0px; --arrow-y: 4px"
      >
        Explorar enfoques{' '}
        <ArrowDown size={16} aria-hidden="true" data-card-arrow />
      </Button>
    </ImmersiveHero>

    <Section id="F2" class="academy-section" aria-labelledby="approach-title">
      <div class="section-intro" data-reveal="ink">
        <SectionHeading id="approach-title">
          Construye con IA. Entiende lo que construyes.
        </SectionHeading>
        <p>
          Aprender con IA va más allá de utilizar herramientas. Buscamos que
          desarrolles capacidades que puedas aplicar a distintos proyectos,
          problemas y tecnologías.
        </p>
      </div>
      <ul class="info-grid" role="list" data-reveal-group>
        {pillars.map(({ title, description, icon }) => (
          <li data-reveal="card">
            <InformationalCard {title} {description}>
              <AcademyMotif slot="icon" name={icon} />
            </InformationalCard>
          </li>
        ))}
      </ul>
    </Section>

    <Section
      id="F3"
      class="academy-section lines"
      tabindex="-1"
      aria-labelledby="lines-title"
    >
      <div class="section-intro" data-reveal="ink">
        <SectionHeading id="lines-title">
          Dos formas de construir con IA
        </SectionHeading>
        <p>
          Explora nuestras dos líneas de aprendizaje según lo que quieras
          desarrollar y las capacidades que quieras adquirir.
        </p>
      </div>
      <ul class="line-grid" role="list" data-reveal-group>
        {lines.map(({ title, eyebrow, description, image }) => (
          <li data-reveal="card">
            <ImmersiveCard
              {title}
              {eyebrow}
              {description}
              {image}
              sizes="(min-width: 86rem) 632px, (min-width: 48rem) 46vw, 92vw"
            />
          </li>
        ))}
      </ul>
    </Section>

    <Section
      id="F4"
      class="academy-section formats"
      aria-labelledby="formats-title"
    >
      <div class="section-intro" data-reveal="ink">
        <SectionHeading id="formats-title">
          Diferentes maneras de aprender y construir
        </SectionHeading>
        <p>
          Experiencias de aprendizaje adaptadas a distintos objetivos y niveles
          de profundidad.
        </p>
      </div>
      <ul class="info-grid" role="list" data-reveal-group>
        {formats.map(({ title, description, icon, tone }) => (
          <li data-reveal="fade">
            <InformationalCard {title} {description} {tone} layout="inline">
              <AcademyMotif slot="icon" name={icon} />
            </InformationalCard>
          </li>
        ))}
      </ul>
    </Section>

    <Section
      id="F5"
      class="academy-section history"
      aria-labelledby="history-title"
    >
      <div class="section-intro" data-reveal="ink">
        <SectionHeading id="history-title">
          Aprendemos construyendo en comunidad
        </SectionHeading>
        <p>
          Nuestra experiencia creando espacios de aprendizaje práctico es el
          punto de partida de AI Academy.
        </p>
      </div>
      <article class="bootcamp" data-reveal="fade">
        <div class="bootcamp-copy">
          <p class="edition">Edición finalizada</p>
          <h3>Bootcamp Gen AI Fundamentals</h3>
          <p>
            Una experiencia de formación práctica con especialistas de Perú,
            Colombia y Estados Unidos.
          </p>
          <TextLink href="/comunidad/#C3">Conoce nuestra trayectoria</TextLink>
        </div>
        <ul class="metrics" role="list">
          {metrics.map(([value, label]) => (
            <li>
              <strong>{value}</strong> {label}
            </li>
          ))}
        </ul>
      </article>
    </Section>

    <ClosingCTA
      id="F6"
      title="Desarrolla las capacidades de tu equipo en IA"
      paragraphs={[
        'Exploremos una propuesta de formación adaptada a los perfiles, necesidades y desafíos de tu organización.',
      ]}
      illustration={academyImages.team}
      buttons={[
        {
          label: 'Explorar formación para equipos',
          href: '/empresas/#EM5',
          variant: 'primary',
        },
      ]}
    />

    <FormCTA
      id="F7"
      headingId="waitlist-title"
      title="Lo próximo que construyas empieza aquí."
      description="Registra tu interés en AI Academy y recibe información sobre futuras convocatorias en nuestras líneas formativas."
      illustration={academyImages.waitlist}
    >
      <form
        id="academy-form"
        action="/api/academy-waitlist"
        method="post"
        aria-labelledby="waitlist-title"
        aria-describedby="waitlist-availability"
      >
        <p id="waitlist-availability">
          No hay convocatorias abiertas y la lista de espera aún no está
          habilitada.
        </p>
        <fieldset disabled aria-label="Datos de registro">
          <FormField
            id="academy-name"
            name="name"
            label="Nombre"
            autocomplete="name"
            maxLength={120}
            placeholder="Tu nombre"
            error="Escribe tu nombre."
          />
          <FormField
            id="academy-email"
            name="email"
            kind="email"
            label="Correo electrónico"
            autocomplete="email"
            maxLength={254}
            placeholder="Tu correo electrónico"
            error="Escribe tu correo electrónico."
          />
          <fieldset class="line-choices">
            <legend>
              ¿Qué línea te interesa? <span aria-hidden="true">*</span>
            </legend>
            {lines.map(({ value, title }) => (
              <label>
                <Radio native name="line" {value} required />
                {title}
              </label>
            ))}
          </fieldset>
          <Button type="submit" variant="primary" disabled>
            Avisarme de próximas convocatorias
          </Button>
        </fieldset>
      </form>
    </FormCTA>
  </main>
  <SiteFooter />
  <EditorialMotion />
</BaseLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    :global(html:has(body.academy)) {
      scroll-behavior: smooth;
    }
  }
  #F3 {
    scroll-margin-top: 0.5rem;
  }
  .academy-section {
    padding-block: clamp(2.75rem, 5.25vw, 5.25rem);
  }
  .section-intro p {
    max-width: 63ch;
    margin-top: var(--space-control);
    color: var(--secondary-text);
  }
  .info-grid,
  .line-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(0.75rem, 1.45vw, 1.25rem);
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }
  .line-grid > li {
    --scene-matte: var(
      --editorial-wood
    ); /* Color del borde inferior de las escenas de madera. */
    display: grid;
    min-width: 0;
  }
  .lines {
    padding-top: 0;
  }
  .lines .section-intro {
    text-align: center;
  }
  .lines .section-intro p {
    margin-inline: auto;
  }
  .formats {
    padding-top: 0;
  }
  .history {
    padding-top: 0;
  }
  .bootcamp {
    display: grid;
    gap: clamp(1.35rem, 4vw, 3rem);
    align-items: center;
    margin-top: clamp(1.5rem, 3vw, 2rem);
    padding-block: clamp(1.25rem, 3vw, 2.25rem);
  }
  .bootcamp h3 {
    margin-block: 0.45rem;
  }
  .bootcamp-copy p {
    max-width: 46ch;
    color: var(--secondary-text);
  }
  .bootcamp-copy .edition {
    font-size: var(--type-label);
    font-weight: var(--weight-heading);
    color: var(--editorial-sand-ink);
  }
  .bootcamp-copy :global(.text-link) {
    margin-top: var(--space-related);
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    color: var(--secondary-text);
  }
  .metrics li {
    display: grid;
    align-content: start;
    padding-inline: clamp(0.3rem, 2vw, 1.35rem);
    border-inline-start: var(--stroke-default) solid var(--line);
    text-align: center;
  }
  .metrics li:last-child {
    border-inline-end: var(--stroke-default) solid var(--line);
  }
  .metrics strong {
    color: var(--foreground);
    font: 600 clamp(1.6rem, 0.95rem + 4vw, 4.25rem)/1.1 var(--font-heading);
    letter-spacing: -0.04em;
  }
  fieldset {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-stack);
    min-width: 0;
  }
  .line-choices {
    gap: var(--space-inline);
  }
  .line-choices legend {
    margin-bottom: 0.35rem;
    font-weight: var(--weight-medium);
  }
  .line-choices label {
    display: flex;
    align-items: center;
    gap: var(--space-control);
    padding: var(--space-related) var(--space-control);
    border: var(--stroke-default) solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--editorial-background);
    color: var(--secondary-text);
  }
  .line-choices input {
    appearance: auto;
    flex: none;
    width: 1rem;
    height: 1rem;
  }
  #waitlist-availability {
    margin-bottom: 1rem;
    color: var(--secondary-text);
    font-weight: var(--weight-heading);
  }
  #academy-form :global(.form-field input:disabled) {
    color: var(--secondary-text);
    border-color: var(--line);
    opacity: 1;
  }
  #academy-form :global(.form-field input:disabled::placeholder) {
    color: var(--muted-foreground);
    opacity: 1;
  }
  #academy-form :global(button) {
    width: fit-content;
    max-width: 100%;
    height: auto;
    min-height: 2.75rem;
    white-space: normal;
    padding-block: 0.625rem;
  }
  #academy-form :global(button:disabled) {
    background: var(--editorial-sand);
    color: var(--secondary-text);
    opacity: 1;
  }
  @media (min-width: 48rem) {
    .line-grid,
    .bootcamp {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 44rem) {
    .info-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
