{
  "name": "app-aiplaygrounds",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "types:worker": "wrangler types worker-configuration.d.ts",
    "check:worker": "npm run types:worker && tsc --noEmit -p worker/tsconfig.json",
    "build:worker": "wrangler deploy --dry-run --outdir .wrangler/build",
    "dev:worker": "wrangler dev --local",
    "lint": "eslint src worker scripts tests *.mjs",
    "format:check": "prettier --check src worker scripts tests *.mjs *.json .github/workflows/*.yml",
    "validate:content": "node scripts/validate-content.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "check:output": "node scripts/check-output.mjs",
    "ci:check": "npm run lint && npm run format:check && npm run check && npm run check:worker && npm run validate:content && npm run test:unit && npm run build && npm run build:worker && npm run check:output"
  },
  "dependencies": {
    "@lucide/astro": "1.69.0",
    "@starwind-ui/astro": "1.4.0",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.7",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "starwind": "3.5.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "wrangler": "4.158.0"
  }
}
