{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aiplaygrounds-academy-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-05",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // Clave ficticia pública de Cloudflare, sin acceso a ningún recurso remoto.
    "ACADEMY_TURNSTILE_SECRET": "1x0000000000000000000000000000000AA",
  },
  "kv_namespaces": [
    {
      "binding": "ACADEMY_WAITLIST_MOCK",
      "id": "00000000000000000000000000000001",
      "remote": false,
    },
  ],
}
